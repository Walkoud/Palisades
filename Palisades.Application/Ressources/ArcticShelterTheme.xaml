<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Glow Effect -->
    <DropShadowEffect x:Key="ArcticGlowEffect" Color="#7DD3FC" BlurRadius="6" ShadowDepth="0" Opacity="0.4" />

    <Style TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource GuiBackgroundCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GuiBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource GuiAccentBrush}" />
                <Setter Property="Effect" Value="{StaticResource ArcticGlowEffect}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource GuiBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource GuiTextForegroundBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource GuiAccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource GuiBackgroundMainBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GuiAccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Border Background="Transparent">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- Track -->
                            <Border Grid.Row="1" Height="4" Margin="6,0"
                                    Background="{DynamicResource GuiBorderBrush}"
                                    CornerRadius="0" />
                            <!-- Thumb -->
                            <Track Grid.Row="1" Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Width="12" Height="20"
                                           BorderThickness="0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource GuiAccentBrush}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource GuiTextForegroundBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="16" Height="16"
                                Background="#0B0F13"
                                BorderBrush="{DynamicResource GuiBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="0"
                                VerticalAlignment="Center">
                            <Border Visibility="Collapsed" x:Name="CheckMark"
                                    Width="8" Height="8"
                                    Background="{DynamicResource GuiAccentBrush}"
                                    CornerRadius="0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                        </Border>
                        <ContentPresenter Grid.Column="1"
                                          Margin="6,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Background" Value="{DynamicResource GuiBackgroundMainBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GuiBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource GuiAccentBrush}" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{DynamicResource GuiBackgroundCardBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource GuiTextForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,4" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource GuiAccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource GuiBackgroundMainBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource GuiBorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource GuiAccentBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#0B0F13" />
        <Setter Property="BorderBrush" Value="{DynamicResource GuiBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource GuiTextForegroundBrush}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

</ResourceDictionary>