<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Kali rounded context menu : dark glass, cyan edge, soft shadow -->
    <DropShadowEffect x:Key="KaliMenuShadow"
                      Color="Black" Opacity="0.55"
                      BlurRadius="22" ShadowDepth="0" Direction="0" />

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="230" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="#E8EEF4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <!-- transparent padding lets custom shadow show + keeps real corners round -->
                    <Grid Background="Transparent" Margin="0,4,10,10">
                        <Border CornerRadius="12"
                                Background="#F2181E26"
                                BorderBrush="#3D00E5FF"
                                BorderThickness="1"
                                Padding="6"
                                SnapsToDevicePixels="True"
                                Effect="{StaticResource KaliMenuShadow}">
                            <!-- top cyan hairline glow -->
                            <Border CornerRadius="11" Background="Transparent"
                                    BorderBrush="#1400E5FF" BorderThickness="0,1,0,0">
                                <ItemsPresenter Margin="0"
                                                KeyboardNavigation.DirectionalNavigation="Cycle"
                                                SnapsToDevicePixels="True" />
                            </Border>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Subtle thin separator -->
    <Style TargetType="{x:Type Separator}">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="#FF2A3340" />
        <Setter Property="Margin" Value="10,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="0.5"
                            Height="1"
                            Margin="{TemplateBinding Margin}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Kali menu item : rounded hover pill, cyan left tick when checked -->
    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#E8EEF4" />
        <Setter Property="Padding" Value="10,7,12,7" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bd"
                                CornerRadius="8"
                                Background="Transparent"
                                BorderThickness="1"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}"
                                MinHeight="{TemplateBinding MinHeight}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- check / icon zone -->
                                <ContentPresenter x:Name="IconHost"
                                                  Grid.Column="0"
                                                  ContentSource="Icon"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0" />
                                <!-- checked dot fallback when no icon but checkable -->
                                <Ellipse x:Name="CheckDot"
                                         Grid.Column="0"
                                         Width="6" Height="6"
                                         Fill="#FF00E5FF"
                                         Margin="5,0,7,0"
                                         VerticalAlignment="Center"
                                         Visibility="Collapsed" />
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                                <TextBlock x:Name="Arrow"
                                           Grid.Column="2"
                                           Text="›"
                                           FontSize="14"
                                           Foreground="#FF7D8CA3"
                                           VerticalAlignment="Center"
                                           Margin="14,0,2,0"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Popup x:Name="SubPopup"
                               Placement="Right"
                               HorizontalOffset="-2"
                               VerticalOffset="-6"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsSubmenuOpen}">
                            <ContentControl>
                                <Border CornerRadius="12"
                                        Background="#F2181E26"
                                        BorderBrush="#3D00E5FF"
                                        BorderThickness="1"
                                        Padding="6"
                                        MinWidth="200"
                                        Effect="{StaticResource KaliMenuShadow}">
                                    <ItemsPresenter SnapsToDevicePixels="True" />
                                </Border>
                            </ContentControl>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckDot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FF232D3B" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#3300E5FF" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#FF5D6B82" />
                        </Trigger>
                        <!-- role=SubmenuHeader keeps same look but arrow visible -->
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
