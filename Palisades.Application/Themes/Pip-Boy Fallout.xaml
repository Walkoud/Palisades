<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- Theme Meta -->
    <system:String x:Key="ThemeName">Pip-Boy Fallout</system:String>

    <!-- Procedural Scanline Background Brush -->
    <DrawingBrush x:Key="ContainerBackgroundBrush" TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <!-- Solid Dark Green Background -->
                <GeometryDrawing Brush="#E5071108">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,4,4" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!-- Horizontal Scanline -->
                <GeometryDrawing Brush="#1C00FF55">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,4,1" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- Container Theme Brushes -->
    <SolidColorBrush x:Key="ContainerBorderBrush" Color="#FF00FF55" />
    <SolidColorBrush x:Key="ContainerBorderBrushHover" Color="#FF33FF77" />
    <SolidColorBrush x:Key="ContainerHeaderBrush" Color="#E50D2410" />
    <SolidColorBrush x:Key="ContainerHeaderBrushHover" Color="#FF00FF55" />
    <SolidColorBrush x:Key="ContainerTitleForeground" Color="#FF00FF55" />
    <SolidColorBrush x:Key="ContainerLabelsForeground" Color="#FF00FF55" />

    <!-- Container Layout Options -->
    <CornerRadius x:Key="ContainerCornerRadius">4</CornerRadius>
    <Thickness x:Key="ContainerBorderThickness">2</Thickness>

</ResourceDictionary>
