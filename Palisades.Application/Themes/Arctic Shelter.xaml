<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- Theme Meta -->
    <system:String x:Key="ThemeName">Arctic Shelter</system:String>

    <!-- Container Theme Brushes -->
    <SolidColorBrush x:Key="ContainerBackgroundBrush" Color="#DF151B22" />
    <SolidColorBrush x:Key="ContainerBorderBrush" Color="#FF222A35" />
    <SolidColorBrush x:Key="ContainerBorderBrushHover" Color="#FF7DD3FC" />
    <SolidColorBrush x:Key="ContainerHeaderBrush" Color="#FF11161B" />
    <SolidColorBrush x:Key="ContainerHeaderBrushHover" Color="#FF7DD3FC" />
    <SolidColorBrush x:Key="ContainerTitleForeground" Color="#FF7DD3FC" />
    <SolidColorBrush x:Key="ContainerLabelsForeground" Color="#FFE2F1FF" />

    <!-- Container Layout Options -->
    <CornerRadius x:Key="ContainerCornerRadius">12</CornerRadius>
    <Thickness x:Key="ContainerBorderThickness">1</Thickness>

</ResourceDictionary>
