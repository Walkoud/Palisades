<Window x:Class="Palisades.Views.ContainerTypeSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:Palisades.Services"
        Title="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[TypeSel_WindowTitle]}"
        Height="360" Width="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">
    <Border Background="#141920" BorderBrush="#222A35" BorderThickness="1.5" CornerRadius="12">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header Title -->
            <Grid Grid.Row="0" Margin="0,0,0,16" MouseLeftButtonDown="Title_MouseDown">
                <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[TypeSel_Title]}"
                           FontSize="18" FontWeight="SemiBold" Foreground="#E2F1FF" HorizontalAlignment="Center" />
            </Grid>

            <!-- Buttons Selection Grid -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <!-- Standard/Normal Container Button -->
                <Button Margin="0,6,0,6" Height="50" Cursor="Hand" Click="Normal_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="#1C242E" BorderBrush="#2A3542" BorderThickness="1" CornerRadius="8" Padding="14,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📂" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[TypeSel_Standard_Title]}" FontSize="13" FontWeight="SemiBold" Foreground="#E2F1FF" />
                                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[TypeSel_Standard_Desc]}" FontSize="10" Foreground="#526475" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#0F7DD3FC"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#7DD3FC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- SVG Button Container Button -->
                <Button Margin="0,6,0,6" Height="50" Cursor="Hand" Click="SvgButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="#1C242E" BorderBrush="#2A3542" BorderThickness="1" CornerRadius="8" Padding="14,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🎨" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[TypeSel_Svg_Title]}" FontSize="13" FontWeight="SemiBold" Foreground="#E2F1FF" />
                                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[TypeSel_Svg_Desc]}" FontSize="10" Foreground="#526475" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#0F7DD3FC"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#7DD3FC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Folder Portal Button -->
                <Button Margin="0,6,0,6" Height="50" Cursor="Hand" Click="FolderPortal_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="#1C242E" BorderBrush="#2A3542" BorderThickness="1" CornerRadius="8" Padding="14,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🔄" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[TypeSel_Portal_Title]}" FontSize="13" FontWeight="SemiBold" Foreground="#E2F1FF" />
                                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[TypeSel_Portal_Desc]}" FontSize="10" Foreground="#526475" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#0F7DD3FC"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#7DD3FC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- Bottom Actions -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Button Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[TypeSel_Cancel]}" Click="Cancel_Click" Width="80" Height="28" HorizontalAlignment="Right" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="#1C242E" BorderBrush="#2A3542" BorderThickness="1" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[TypeSel_Cancel]}" TextBlock.Foreground="#8A9CAE" TextBlock.FontSize="11" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#30FF5F56" />
                                    <Setter TargetName="border" Property="BorderBrush" Value="#FF5F56" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
