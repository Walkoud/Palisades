<UserControl x:Class="Palisades.Views.Controls.DynamicIslandControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Palisades.ViewModels"
             xmlns:conv="clr-namespace:Palisades.Converters"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:IslandWidgetVisibilityConverter x:Key="IslandWidgetVis" />
        <Style x:Key="IslandIconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#22FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border x:Name="IslandRoot"
            Background="{Binding IslandBackgroundBrush}"
            BorderBrush="{Binding BorderBrush}"
            BorderThickness="1"
            CornerRadius="{Binding IslandCornerRadius}"
            Padding="6,4"
             MinWidth="{Binding CompactMinWidth}" MaxWidth="{Binding CompactMaxWidth}"
            SnapsToDevicePixels="True"
             HorizontalAlignment="Center" VerticalAlignment="Top">
        <Border.RenderTransform>
            <!-- Expand-up : translate GPU qui garde la pastille fixe pendant
                 que le panneau pousse au-dessus (zéro layout par frame) -->
            <TranslateTransform x:Name="RootShift" />
        </Border.RenderTransform>
        <StackPanel x:Name="MainStack">
            <!-- COMPACT : pilule -->
            <Grid x:Name="CompactRow" Height="34" MouseLeftButtonUp="CompactRow_Click">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- indicateur / horloge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,2,0">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#404040" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NpPlaying}" Value="True">
                                        <Setter Property="Fill" Value="{Binding AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ClockText}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{Binding ForegroundBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- centre : artiste en cours (le titre est déjà à droite, pas de doublon) -->
                <TextBlock Grid.Column="1" Text="{Binding NpArtist}" FontSize="11"
                           VerticalAlignment="Center" Margin="6,0" MaxWidth="200"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{Binding MutedBrush}"
                           Visibility="{Binding IsNowPlayingPinned, Converter={StaticResource BoolToVis}}" />
                <TextBlock Grid.Column="1" FontSize="11"
                           VerticalAlignment="Center" Margin="6,0" MaxWidth="200"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{Binding MutedBrush}"
                           Text="{Binding CurrentWidget.Name}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNowPlayingPinned}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- NowPlaying compact : titre + eq + play (visible seulement si pinné) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,2,0"
                            Visibility="{Binding IsNowPlayingPinned, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0"
                                Visibility="{Binding NpPlaying, Converter={StaticResource BoolToVis}}">
                        <Rectangle Width="3" Height="12" Fill="{Binding AccentBrush}" Margin="1,0" VerticalAlignment="Center">
                            <Rectangle.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="Height" From="5" To="13" Duration="0:0:0.4" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Rectangle.Triggers>
                        </Rectangle>
                        <Rectangle Width="3" Height="8" Fill="{Binding AccentBrush}" Margin="1,0" VerticalAlignment="Center">
                            <Rectangle.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="Height" From="12" To="5" Duration="0:0:0.5" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Rectangle.Triggers>
                        </Rectangle>
                        <Rectangle Width="3" Height="13" Fill="{Binding AccentBrush}" Margin="1,0" VerticalAlignment="Center">
                            <Rectangle.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="Height" From="6" To="12" Duration="0:0:0.35" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Rectangle.Triggers>
                        </Rectangle>
                    </StackPanel>
                    <TextBlock Text="{Binding NpTitle}" FontSize="11" Width="130"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,4,0"
                               Foreground="{Binding MutedBrush}" />
                    <Button Style="{StaticResource IslandIconBtn}"
                            Content="{Binding PlayGlyph}"
                            Foreground="{Binding ForegroundBrush}"
                            Command="{Binding TogglePlayCommand}" />
                    <Button Style="{StaticResource IslandIconBtn}"
                            Content="&#xE76B;"
                            Foreground="{Binding MutedBrush}"
                            Click="ToggleButton_Click"
                            Command="{Binding ToggleExpandCommand}" />
                </StackPanel>
            </Grid>

            <!-- EXPANDED : carte détaillée -->
            <!-- Replié = Collapsed (taille 0 : ni largeur, ni hauteur, ni marges).
                 Les vues restent chargées (Collapsed ne décharge pas), données chaudes. -->
            <Border x:Name="ExpandedPanel" Margin="2,4,2,2" CornerRadius="16"
                    Background="#0DFFFFFF" Padding="10" ClipToBounds="True"
                    Visibility="Collapsed">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ExpandScale" />
                        <TranslateTransform x:Name="ExpandSlide" />
                    </TransformGroup>
                </Border.RenderTransform>
                <StackPanel x:Name="ExpandedStack">
                    <!-- sélecteur widgets : visible uniquement à l'ouverture -->
                    <ScrollViewer x:Name="WidgetScroller"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  PanningMode="HorizontalOnly"
                                  PreviewMouseWheel="WidgetScroller_Wheel"
                                  Margin="0,0,0,8">
                        <ItemsControl ItemsSource="{Binding Widgets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                <Border Margin="3,0" Padding="8,3" CornerRadius="14" Cursor="Hand"
                                        MouseLeftButtonUp="WidgetCard_Click" Tag="{Binding}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#1AFFFFFF" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#26FFFFFF" />
                                                    <Setter Property="BorderBrush" Value="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"
                                                       Foreground="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            <TextBlock Text="{Binding Name}" FontSize="12"
                                                       VerticalAlignment="Center" MaxWidth="90"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{Binding DataContext.ForegroundBrush, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- en-tête widget courant : pochette | texte extensible | nom (prioritaire) -->
                    <Grid x:Name="WidgetHeader" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" ClipToBounds="True"
                                Background="#22FFFFFF" Margin="0,0,10,0">
                            <TextBlock Text="{Binding CurrentWidget.Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{Binding MutedBrush}" />
                        </Border>
                        <!-- Now Playing : titre live (masqué si la vraie vue NP est dessous) -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                    Visibility="{Binding IsNpSummaryVisible, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding NpTitle}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{Binding ForegroundBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding NpArtist}" FontSize="11"
                                       Foreground="{Binding MutedBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <!-- autre widget : nom (jamais tronqué, le titre rogne à la place) -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" MaxWidth="140">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCurrentNowPlaying}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{Binding CurrentWidget.Name}" FontSize="13" FontWeight="SemiBold"
                                       TextAlignment="Right"
                                       Foreground="{Binding ForegroundBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding DateText}" FontSize="11"
                                       TextAlignment="Right"
                                       Foreground="{Binding MutedBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <!-- contrôles média : résumé NP (masqués si la vraie vue NP est dessous) -->
                    <StackPanel x:Name="MediaControls" Visibility="{Binding IsNpSummaryVisible, Converter={StaticResource BoolToVis}}">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding NpPositionText}" FontSize="10"
                                   Foreground="{Binding MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="{Binding NpDuration}" Value="{Binding NpPosition, Mode=TwoWay}"
                                VerticalAlignment="Center" Height="18"
                                PreviewMouseLeftButtonUp="SeekSlider_Released" />
                        <TextBlock Grid.Column="2" Text="{Binding NpDurationText}" FontSize="10"
                                   Foreground="{Binding MutedBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,6">
                        <Button Style="{StaticResource IslandIconBtn}" Content="&#xE892;"
                                Foreground="{Binding MutedBrush}" Command="{Binding PrevTrackCommand}"
                                FontSize="14" Width="34" Height="30" />
                        <Button Content="{Binding PlayGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                Foreground="{Binding ForegroundBrush}" Command="{Binding TogglePlayCommand}"
                                Width="40" Height="32" Cursor="Hand" Margin="8,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CornerRadius="16" Opacity="0.9">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Style="{StaticResource IslandIconBtn}" Content="&#xE893;"
                                Foreground="{Binding MutedBrush}" Command="{Binding NextTrackCommand}"
                                FontSize="14" Width="34" Height="30" />
                    </StackPanel>
                    </StackPanel>

                    <!-- hôte empilé : toutes les vues restent chargées (données chaudes,
                         pas de lag), seule la sélectionnée s'affiche -->
                    <ItemsControl x:Name="WidgetHost" MaxHeight="{Binding CurrentWidgetHeight}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ContentPresenter Content="{Binding ExpandedView}">
                                    <ContentPresenter.Visibility>
                                        <MultiBinding Converter="{StaticResource IslandWidgetVis}">
                                            <Binding />
                                            <Binding Path="DataContext.CurrentWidget" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            <Binding Path="DataContext.IsExpanded" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </MultiBinding>
                                    </ContentPresenter.Visibility>
                                </ContentPresenter>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- grip resize souris : glisser vertical = taille du widget -->
                    <Thumb x:Name="ResizeGrip" Height="12" Cursor="SizeNS" Margin="0,4,0,0"
                           DragDelta="ResizeGrip_Drag" DragCompleted="ResizeGrip_Done">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Grid Background="Transparent">
                                    <Border Width="44" Height="4" CornerRadius="2" Opacity="0.5"
                                            Background="{Binding MutedBrush}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
