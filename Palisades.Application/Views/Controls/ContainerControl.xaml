<UserControl x:Class="Palisades.Views.Controls.ContainerControl"
        x:Name="ThisControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Palisades.ViewModels"
        xmlns:conv="clr-namespace:Palisades.Converters"
        xmlns:controls="clr-namespace:Palisades.Views.Controls"
        xmlns:dd="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.WPF.DragDrop"
         xmlns:local="clr-namespace:Palisades.Views"
         xmlns:svc="clr-namespace:Palisades.Services"
         mc:Ignorable="d"
        Width="{Binding Width}"
        Height="{Binding Height}"
        Opacity="{Binding CurrentOpacity, Mode=OneWay}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        local:ContainerVisuals.ShowShortcutArrow="{Binding ShowShortcutArrow}"
        MouseMove="ContainerControl_MouseMove"
        MouseUp="ContainerControl_MouseUp"
        SizeChanged="ContainerControl_SizeChanged"
        ContextMenuOpening="ContainerControl_ContextMenuOpening"
        d:DataContext="{d:DesignInstance vm:ContainerViewModel}">
    <UserControl.ContextMenu>
        <ContextMenu Background="#2A2A2A" Foreground="#EEE" BorderBrush="#444" BorderThickness="1">
            <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Container_ContextMenu_Lock]}" Command="{Binding ToggleLockCommand}" />
            <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Container_ContextMenu_AutoHide]}" Command="{Binding ToggleAutoHideCommand}" />
            <Separator Background="#444" />
            <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Container_ContextMenu_EditProperties]}" Command="{Binding EditCommand}" />
            <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Container_ContextMenu_DeleteContainer]}" Command="{Binding DeleteCommand}" />
        </ContextMenu>
    </UserControl.ContextMenu>
    <UserControl.Resources>
        <conv:SvgToImageConverter x:Key="SvgToImageConverter" />
        <conv:FilePathToImageConverter x:Key="FilePathToImageConverter" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <conv:PathToImageConverter x:Key="IconConverter" ShowArrow="True" />
        <conv:PathToImageConverter x:Key="IconNoArrowConverter" ShowArrow="False" />
        <conv:StringToTextAlignmentConverter x:Key="TextAlignmentConverter" />
        <conv:BorderThicknessConverter x:Key="BorderThicknessConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:InvertBoolConverter x:Key="InvertBoolConverter" />
        <conv:EqualsConverter x:Key="EqualsConverter" />
        <controls:ShortcutReorderHandler x:Key="ReorderHandler" />
        <conv:BindingProxy x:Key="VmProxy" Data="{Binding}" />
        <conv:ColorToBrushConverter x:Key="ColorToBrushConverter" />
        <CollectionViewSource x:Key="ShortcutsView" Source="{Binding Shortcuts}" />

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Root" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Margin="1,2">
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Width" Value="6" />
                                                <Setter Property="MinHeight" Value="24" />
                                                <Setter Property="Background" Value="#55FFFFFF" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="4" />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Width" Value="8" />
                                                        <Setter Property="Background" Value="#99FFFFFF" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter Property="Width" Value="8" />
                                                        <Setter Property="Background" Value="#CCFFFFFF" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Thumb" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Delete" Command="{Binding DeleteShortcutCommand}" />
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoLastDeleteCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="7">
        <Border x:Name="MainBorder"
                MouseEnter="MainBorder_MouseEnter"
                MouseLeave="MainBorder_MouseLeave"
                MouseRightButtonUp="MainBorder_RightClick"
                AllowDrop="True"
                Drop="MainBorder_Drop">
            <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#25FFFFFF" />
                        <Setter Property="CornerRadius" Value="{Binding CornerRadius}" />
                        <Setter Property="BorderThickness" Value="{Binding ShowBorder, Converter={StaticResource BorderThicknessConverter}}" />
                        <Setter Property="Background" Value="{Binding BodyColorWithOpacity, Converter={StaticResource ColorToBrushConverter}}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHovered}" Value="True">
                                <Setter Property="BorderBrush" Value="#45FFFFFF" />
                            </DataTrigger>
                            
                            <!-- Global Theme Active -->
                            <DataTrigger Binding="{Binding IsThemeActive}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ContainerBackgroundBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ContainerBorderBrush}" />
                                <Setter Property="BorderThickness" Value="{DynamicResource ContainerBorderThickness}" />
                                <Setter Property="CornerRadius" Value="{DynamicResource ContainerCornerRadius}" />
                            </DataTrigger>
                            
                            <!-- Global Theme Hover -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsThemeActive}" Value="True" />
                                    <Condition Binding="{Binding IsHovered}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="BorderBrush" Value="{DynamicResource ContainerBorderBrushHover}" />
                            </MultiDataTrigger>
                            
                            <!-- User Options Overrides for Global Theme -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsThemeActive}" Value="True" />
                                    <Condition Binding="{Binding ShowBorder}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="BorderThickness" Value="0" />
                            </MultiDataTrigger>
                            
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsThemeActive}" Value="True" />
                                    <Condition Binding="{Binding RoundedCornersEnabled}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="CornerRadius" Value="0" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
            </Border.Style>

        <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header / Title Bar (iTop-like) -->
                <Grid Grid.Row="0"
                      Height="34"
                      Background="Transparent"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown"
                      MouseEnter="HeaderBar_MouseEnter"
                      MouseLeave="HeaderBar_MouseLeave"
                      Visibility="{Binding ShowTitleVisibility}"
                      x:Name="HeaderBar">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Rectangle Grid.ColumnSpan="3" IsHitTestVisible="False" RadiusY="0" RadiusX="0">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Fill">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{Binding HeaderColor}" />
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTitleHovered}" Value="True">
                                        <Setter Property="Fill" Value="#FF303030" />
                                    </DataTrigger>
                                    
                                    <!-- Global Theme Active -->
                                    <DataTrigger Binding="{Binding IsThemeActive}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource ContainerHeaderBrush}" />
                                    </DataTrigger>
                                    
                                    <!-- Global Theme Hover -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsThemeActive}" Value="True" />
                                            <Condition Binding="{Binding IsTitleHovered}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Fill" Value="{DynamicResource ContainerHeaderBrushHover}" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>

                    <!-- Center: Title / Search hybrid -->
                    <Grid Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Title TextBlock (visible when not searching) -->
                        <TextBlock Text="{Binding HeaderText}"
                                   FontFamily="{Binding TitleFontFamily}"
                                   FontSize="{Binding TitleFontSize}"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   IsHitTestVisible="True"
                                   MouseDown="TitleTextBlock_MouseDown">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="Foreground">
                                        <Setter.Value>
                                            <SolidColorBrush Color="{Binding TitleColor}" />
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSearchActive}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEditingTitle}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <!-- Global Theme Active -->
                                        <DataTrigger Binding="{Binding IsThemeActive}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource ContainerTitleForeground}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Search TextBox (pill design, visible when searching) -->
                        <TextBox x:Name="SearchBox"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{Binding TitleFontFamily}"
                                 FontSize="{Binding TitleFontSize}"
                                 FontWeight="SemiBold"
                                 Background="#33FFFFFF" BorderBrush="#66FFFFFF"
                                 BorderThickness="1"
                                 Padding="6,1"
                                 Foreground="#FFF"
                                 KeyDown="SearchBox_KeyDown"
                                 LostFocus="SearchBox_LostFocus"
                                 IsHitTestVisible="True">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border x:Name="border" CornerRadius="10"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="⌕" FontSize="11"
                                                                   Foreground="#88FFFFFF"
                                                                   VerticalAlignment="Center" Margin="0,0,4,0" />
                                                        <ScrollViewer Grid.Column="1" x:Name="PART_ContentHost"
                                                                      VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSearchActive}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- Rename TextBox (hidden by default, shown when editing title) -->
                        <TextBox x:Name="TitleEditBox"
                                 Text="{Binding EditingTitle, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{Binding TitleFontFamily}"
                                 FontSize="{Binding TitleFontSize}"
                                 FontWeight="SemiBold"
                                 Background="#33FFFFFF" BorderBrush="#66FFFFFF"
                                 BorderThickness="1" Padding="2,1"
                                 Foreground="#FFF"
                                 KeyDown="TitleEdit_KeyDown"
                                 LostFocus="TitleEdit_LostFocus"
                                 IsHitTestVisible="True">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditingTitle}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>

                    <!-- Left: Hamburger + Search buttons -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVisuallyCollapsed}" Value="True">
                                        <Setter Property="Opacity" Value="0" />
                                        <Setter Property="IsHitTestVisible" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Width="34" Height="30" Margin="2,0,0,0" Padding="1"
                                Background="Transparent" BorderThickness="0"
                                ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Container_Tooltip_Menu]}"
                                Click="HamburgerButton_Click">
                            <Viewbox Stretch="Uniform"
                                     Width="{Binding HeaderIconSize}"
                                     Height="{Binding HeaderIconSize}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Grid Width="9" Height="9">
                                    <Path Data="M0,1 L9,1 M0,4.5 L9,4.5 M0,8 L9,8"
                                          Stroke="White" StrokeThickness="1.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Grid>
                            </Viewbox>
                            <Button.ContextMenu>
                                <ContextMenu Background="#2A2A2A" Foreground="#EEE" BorderBrush="#444" BorderThickness="1">
                                    <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_CreateShortcut]}" Command="{Binding Data.CreateShortcutCommand, Source={StaticResource VmProxy}}" />
                                    <Separator Background="#444" />
                                    <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Display]}">
                                        <MenuItem.Icon>
                                            <TextBlock Text="🎨" FontSize="14" />
                                        </MenuItem.Icon>
                                        <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Filter]}">
                                            <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_All]}" Command="{Binding Data.ToggleOptionCommand, Source={StaticResource VmProxy}}" CommandParameter="FilterAll" />
                                            <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Programs]}" Command="{Binding Data.ToggleOptionCommand, Source={StaticResource VmProxy}}" CommandParameter="FilterPrograms" />
                                            <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Documents]}" Command="{Binding Data.ToggleOptionCommand, Source={StaticResource VmProxy}}" CommandParameter="FilterDocuments" />
                                            <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Folders]}" Command="{Binding Data.ToggleOptionCommand, Source={StaticResource VmProxy}}" CommandParameter="FilterFolders" />
                                        </MenuItem>
                                        <Separator Background="#444" />
                                        <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_ShowCounters]}" IsCheckable="True"
                                                  IsChecked="{Binding Data.ShowCounter, Source={StaticResource VmProxy}}"
                                                  Command="{Binding Data.ToggleOptionCommand, Source={StaticResource VmProxy}}" CommandParameter="ShowCounter" />
                                        <Separator Background="#444" />
                                        <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_ViewMode]}">
                                            <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Icons]}" IsCheckable="True"
                                                      IsChecked="{Binding Data.IsDetailsView, Source={StaticResource VmProxy}, Converter={StaticResource InvertBoolConverter}, Mode=OneWay}"
                                                      Command="{Binding Data.ToggleOptionCommand, Source={StaticResource VmProxy}}" CommandParameter="IconsView" />
                                            <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Details]}" IsCheckable="True"
                                                      IsChecked="{Binding Data.IsDetailsView, Source={StaticResource VmProxy}, Mode=OneWay}"
                                                      Command="{Binding Data.ToggleOptionCommand, Source={StaticResource VmProxy}}" CommandParameter="DetailsView" />
                                        </MenuItem>
                                        <Separator Background="#444" />
                                        <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_IconSize]}">
                                            <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Small]}" Command="{Binding Data.SetIconSizeCommand, Source={StaticResource VmProxy}}" CommandParameter="24" />
                                            <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Medium]}" Command="{Binding Data.SetIconSizeCommand, Source={StaticResource VmProxy}}" CommandParameter="36" />
                                            <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Large]}" Command="{Binding Data.SetIconSizeCommand, Source={StaticResource VmProxy}}" CommandParameter="48" />
                                            <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_XLarge]}" Command="{Binding Data.SetIconSizeCommand, Source={StaticResource VmProxy}}" CommandParameter="64" />
                                        </MenuItem>
                                    </MenuItem>
                                    <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Options]}">
                                        <MenuItem.Icon>
                                            <TextBlock Text="⚙" FontSize="14" />
                                        </MenuItem.Icon>
                                        <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_AutoHide]}" IsCheckable="True"
                                                  IsChecked="{Binding Data.AutoHide, Source={StaticResource VmProxy}}"
                                                  Command="{Binding Data.ToggleOptionCommand, Source={StaticResource VmProxy}}" CommandParameter="AutoHide" />
                                        <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Lock]}" IsCheckable="True"
                                                  IsChecked="{Binding Data.IsLocked, Source={StaticResource VmProxy}}"
                                                  Command="{Binding Data.ToggleOptionCommand, Source={StaticResource VmProxy}}" CommandParameter="IsLocked" />
                                        <MenuItem Header="SVG Button Mode" IsCheckable="True"
                                                  IsChecked="{Binding Data.IsSvgButtonContainer, Source={StaticResource VmProxy}}"
                                                  Command="{Binding Data.ToggleOptionCommand, Source={StaticResource VmProxy}}" CommandParameter="IsSvgButtonContainer" />
                                        <Separator Background="#444" />
                                        <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_RoundedCorners]}" IsCheckable="True"
                                                  IsChecked="{Binding Data.RoundedCornersEnabled, Source={StaticResource VmProxy}}"
                                                  Command="{Binding Data.ToggleOptionCommand, Source={StaticResource VmProxy}}" CommandParameter="RoundedCorners" />
                                        <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_TitleBarHighlight]}" IsCheckable="True"
                                                  IsChecked="{Binding Data.TitleHoverEffect, Source={StaticResource VmProxy}}"
                                                  Command="{Binding Data.ToggleOptionCommand, Source={StaticResource VmProxy}}" CommandParameter="TitleHoverEffect" />
                                        <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Border]}" IsCheckable="True"
                                                  IsChecked="{Binding Data.ShowBorder, Source={StaticResource VmProxy}}"
                                                  Command="{Binding Data.ToggleOptionCommand, Source={StaticResource VmProxy}}" CommandParameter="ShowBorder" />
                                        <Separator Background="#444" />
                                        <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_AnimationSpeed]}">
                                            <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Fast]}" Command="{Binding Data.SetAnimationSpeedCommand, Source={StaticResource VmProxy}}" CommandParameter="200" />
                                            <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Normal]}" Command="{Binding Data.SetAnimationSpeedCommand, Source={StaticResource VmProxy}}" CommandParameter="400" />
                                            <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Slow]}" Command="{Binding Data.SetAnimationSpeedCommand, Source={StaticResource VmProxy}}" CommandParameter="600" />
                                        </MenuItem>
                                    </MenuItem>
                                    <Separator Background="#444" />
                                    <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Actions]}">
                                        <MenuItem.Icon>
                                            <TextBlock Text="⚡" FontSize="14" />
                                        </MenuItem.Icon>
                                        <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_SortAll]}" Command="{Binding Data.SortNowCommand, Source={StaticResource VmProxy}}" />
                                        <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Refresh]}" Command="{Binding Data.RefreshCommand, Source={StaticResource VmProxy}}" />
                                        <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Rename]}" Command="{Binding Data.RenameCommand, Source={StaticResource VmProxy}}" />
                                    </MenuItem>
                                    <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Config]}">
                                        <MenuItem.Icon>
                                            <TextBlock Text="🔧" FontSize="14" />
                                        </MenuItem.Icon>
                                        <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Settings]}" Command="{Binding Data.EditCommand, Source={StaticResource VmProxy}}" />
                                        <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_SortRules]}" Click="HamburgerMenuItem_Click" CommandParameter="Rules" />
                                        <Separator Background="#444" />
                                        <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_SetAsDefault]}" Command="{Binding Data.SetAsDefaultCommand, Source={StaticResource VmProxy}}" />
                                    </MenuItem>
                                    <Separator Background="#444" />
                                    <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Delete]}" Command="{Binding Data.DeleteCommand, Source={StaticResource VmProxy}}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Width="30" Height="30" Margin="0,0,0,0" Padding="1"
                                Background="Transparent" BorderThickness="0"
                                ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Container_Tooltip_Search]}"
                                Click="SearchButton_Click">
                            <Viewbox Stretch="Uniform"
                                     Width="{Binding HeaderIconSize}"
                                     Height="{Binding HeaderIconSize}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Grid Width="9" Height="9">
                                    <Path Data="M1.5,3.5 A2.5,2.5 0 1,1 6.5,3.5 A2.5,2.5 0 1,1 1.5,3.5 M5.5,5.5 L8,8"
                                          Stroke="White" StrokeThickness="1.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Grid>
                            </Viewbox>
                        </Button>
                    </StackPanel>

                    <!-- Right: Lock + Chevron buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVisuallyCollapsed}" Value="True">
                                        <Setter Property="Opacity" Value="0" />
                                        <Setter Property="IsHitTestVisible" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Width="30" Height="30" Margin="0,0,0,0" Padding="1"
                                Background="Transparent" BorderThickness="0"
                                ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Container_Tooltip_LockContainer]}"
                                Click="LockBoxButton_Click"
                                Visibility="{Binding CanLockPrivateBox, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Viewbox Stretch="Uniform"
                                     Width="{Binding HeaderIconSize}"
                                     Height="{Binding HeaderIconSize}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Grid Width="9" Height="9">
                                    <Path Data="M3,4 V2.5 A1.5,1.5 0 1,1 6,2.5 V4 M2,4 H7 V8 H2 Z M4.5,5 L4.5,7"
                                          Stroke="White" StrokeThickness="1.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                </Grid>
                            </Viewbox>
                        </Button>
                        <Button Width="34" Height="30" Margin="0,0,2,0" Padding="1"
                                Background="Transparent" BorderThickness="0"
                                ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Container_Tooltip_CollapseExpand]}"
                                Command="{Binding ToggleCollapseCommand}">
                            <Viewbox Stretch="Uniform"
                                     Width="{Binding HeaderIconSize}"
                                     Height="{Binding HeaderIconSize}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Grid Width="9" Height="9">
                                    <Path x:Name="ChevronPath"
                                          Data="M0,1 L4.5,8 L9,1"
                                          Stroke="White" StrokeThickness="1.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="0" />
                                        </Path.RenderTransform>
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsVisuallyCollapsed}" Value="True">
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                                                     To="180" Duration="0:0:0.3"
                                                                                     DecelerationRatio="0.2" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                                                     To="0" Duration="0:0:0.3"
                                                                                     DecelerationRatio="0.2" />
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Grid>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Content Area -->
                <Grid Grid.Row="1" AllowDrop="True">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVisuallyCollapsed}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                <ScrollViewer x:Name="ContentScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="6">
                        <Grid AllowDrop="True"
                              DragOver="ItemsArea_DragOver"
                              Drop="ItemsArea_Drop">
                        <Canvas x:Name="SelectionCanvas"
                                IsHitTestVisible="False"
                                Panel.ZIndex="10" />
                        <!-- Normal Views (Grid/Details) -->
                        <Grid Visibility="{Binding IsNormalContainer, Converter={StaticResource BoolToVisibilityConverter}}">
                            <!-- Icons view -->
                            <ItemsControl ItemsSource="{Binding Source={StaticResource ShortcutsView}}"
                                          x:Name="ShortcutsControl">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDetailsView}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="4"
                                                CornerRadius="6"
                                                MouseDown="Shortcut_OnMouseDown"
                                                Padding="4,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#25FFFFFF" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel VerticalAlignment="Top"
                                                        HorizontalAlignment="Center"
                                                        Cursor="Hand">
                                                <Grid Width="{Binding Data.ShortcutIconSize, Source={StaticResource VmProxy}}"
                                                      Height="{Binding Data.ShortcutIconSize, Source={StaticResource VmProxy}}"
                                                      Margin="4,2,4,4">
                                                    <Image Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality">
                                                        <Image.Style>
                                                            <Style TargetType="Image">
                                                                <Setter Property="Source" Value="{Binding IconPath, Converter={StaticResource IconConverter}}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding (local:ContainerVisuals.ShowShortcutArrow), RelativeSource={RelativeSource Self}}" Value="False">
                                                                        <Setter Property="Source" Value="{Binding IconPath, Converter={StaticResource IconNoArrowConverter}}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Image.Style>
                                                    </Image>
                                                </Grid>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           TextWrapping="NoWrap"
                                                           TextAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           FontFamily="Segoe UI"
                                                           FontSize="10"
                                                           HorizontalAlignment="Center"
                                                           Margin="2,0,2,2"
                                                           MaxWidth="{Binding Data.ShortcutIconSize, Source={StaticResource VmProxy}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground">
                                                                <Setter.Value>
                                                                    <SolidColorBrush Color="{Binding DataContext.LabelsColor, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.IsThemeActive, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ContainerLabelsForeground}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Details view -->
                            <ItemsControl ItemsSource="{Binding Source={StaticResource ShortcutsView}}"
                                          Visibility="{Binding IsDetailsView, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Foreground">
                                            <Setter.Value>
                                                <SolidColorBrush Color="{Binding LabelsColor}" />
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <!-- Global Theme Active -->
                                            <DataTrigger Binding="{Binding IsThemeActive}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource ContainerLabelsForeground}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="0,0,0,1"
                                                BorderBrush="#15FFFFFF"
                                                Padding="4,6"
                                                MouseDown="Shortcut_OnMouseDown"
                                                Cursor="Hand">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#25FFFFFF" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="2.5*" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="3.5*" />
                                                </Grid.ColumnDefinitions>
                                                <Image Width="20" Height="20"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       VerticalAlignment="Center">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Source" Value="{Binding IconPath, Converter={StaticResource IconConverter}}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding (local:ContainerVisuals.ShowShortcutArrow), RelativeSource={RelativeSource Self}}" Value="False">
                                                                    <Setter Property="Source" Value="{Binding IconPath, Converter={StaticResource IconNoArrowConverter}}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayName}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="8,0,4,0"
                                                           FontSize="12" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding DisplayType}"
                                                           VerticalAlignment="Center"
                                                           Foreground="#AAA"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding TargetPath}"
                                                           VerticalAlignment="Center"
                                                           Foreground="#777"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <!-- SVG Button Container View -->
                        <Grid Visibility="{Binding IsSvgButtonContainer, Converter={StaticResource BoolToVisibilityConverter}}">
                            <WrapPanel Margin="4">
                                <ItemsControl ItemsSource="{Binding Source={StaticResource ShortcutsView}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="6"
                                                    CornerRadius="10"
                                                    Width="{Binding DataContext.SvgButtonSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    Height="{Binding DataContext.SvgButtonSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                    MouseDown="Shortcut_OnMouseDown"
                                                    Cursor="Hand"
                                                    BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#15FFFFFF" />
                                                        <Setter Property="BorderBrush" Value="#25FFFFFF" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#35FFFFFF" />
                                                                <Setter Property="BorderBrush" Value="#803B82F6" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding DataContext.SvgButtonShowBg, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" Value="False">
                                                                <Setter Property="Background" Value="Transparent" />
                                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Border.Resources>
                                                    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
                                                </Border.Resources>
                                                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <!-- Render SVG or Image or Text fallback -->
                                                    <Grid Width="{Binding DataContext.SvgImageSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                          Height="{Binding DataContext.SvgImageSize, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                                                        <!-- SVG Graphic -->
                                                        <Image Source="{Binding SvgContent, Converter={StaticResource SvgToImageConverter}, ConverterParameter='#FFFFFF'}" 
                                                               Stretch="Uniform"
                                                               ToolTip="{Binding DisplayName}"
                                                               RenderOptions.BitmapScalingMode="HighQuality">
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SvgContent}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding SvgContent}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>

                                                        <!-- PNG/JPG/BMP Image -->
                                                        <Image Source="{Binding IconPath, Converter={StaticResource FilePathToImageConverter}}" 
                                                               Stretch="Uniform"
                                                               ToolTip="{Binding DisplayName}"
                                                               RenderOptions.BitmapScalingMode="HighQuality">
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding SvgContent}" Value="{x:Null}" />
                                                                                <Condition Binding="{Binding IconPath}" Value="" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </MultiDataTrigger>
                                                                        <!-- Show if SvgContent is Null/Empty and IconPath is NOT empty -->
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding SvgContent}" Value="{x:Null}" />
                                                                                <Condition Binding="{Binding IconPath, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding SvgContent}" Value="" />
                                                                                <Condition Binding="{Binding IconPath, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>

                                                        <!-- Text Fallback -->
                                                        <TextBlock Text="{Binding DisplayName}" 
                                                                   Foreground="White" 
                                                                   FontSize="10" 
                                                                   FontWeight="SemiBold" 
                                                                   TextAlignment="Center" 
                                                                   VerticalAlignment="Center" 
                                                                   TextWrapping="Wrap"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <!-- Show only if SvgContent is Null/Empty and IconPath is Empty/Null -->
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding SvgContent}" Value="{x:Null}" />
                                                                                <Condition Binding="{Binding IconPath}" Value="" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding SvgContent}" Value="" />
                                                                                <Condition Binding="{Binding IconPath}" Value="" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Add SVG Button + Button -->
                                <Border x:Name="AddSvgButtonBorder"
                                        Margin="6"
                                        CornerRadius="10"
                                        Width="{Binding SvgButtonSize}"
                                        Height="{Binding SvgButtonSize}"
                                        Cursor="Hand"
                                        BorderThickness="1"
                                        Visibility="{Binding HideAddSvgButton, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                                        MouseDown="AddSvgButton_MouseDown">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#0FFFFFFF" />
                                            <Setter Property="BorderBrush" Value="#15FFFFFF" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#20FFFFFF" />
                                                    <Setter Property="BorderBrush" Value="#60FFFFFF" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding SvgButtonShowBg}" Value="False">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="+" Foreground="#88FFFFFF" FontSize="28" FontWeight="Light" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0" />
                                </Border>
                            </WrapPanel>
                        </Grid>
                        </Grid>
                    </ScrollViewer>

                    <!-- Lock overlay for Private Box (on top of ScrollViewer) -->
                    <Border Background="#CC000000"
                            Visibility="{Binding IsPasswordLocked, Converter={StaticResource BoolToVisibilityConverter}}"
                            Panel.ZIndex="10">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🔒" FontSize="48" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Container_LockOverlay_Locked]}"
                                       Foreground="#AAA" FontSize="13" Margin="0,8,0,8"
                                       HorizontalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <PasswordBox x:Name="UnlockPasswordBox"
                                             Width="140"
                                             Background="#333" BorderBrush="#555"
                                             Foreground="#EEE" Padding="6,3" FontSize="12"
                                             KeyDown="UnlockPassword_KeyDown"
                                             PreviewMouseDown="UnlockPassword_PreviewMouseDown" />
                                <Button Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Container_LockOverlay_Unlock]}"
                                        Background="#2A4A2A" BorderBrush="#4A6A4A" BorderThickness="1"
                                        Foreground="#8D8" Padding="8,4" FontSize="11"
                                        Margin="8,0,0,0" Cursor="Hand"
                                        Click="UnlockButton_Click" />
                            </StackPanel>
                            <TextBlock x:Name="UnlockErrorText"
                                       Foreground="#FF6666" FontSize="11"
                                       HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Resize handles — Grid.RowSpan="2" covers full height, Fill="Transparent" enables hit testing -->
                <Grid x:Name="ResizeHandleGrid" Grid.RowSpan="2">
                    <Rectangle x:Name="ResizeLeft" Width="6" HorizontalAlignment="Left"
                               Cursor="SizeWE" MouseMove="Resize_MouseMove" MouseDown="Resize_MouseDown" MouseUp="Resize_MouseUp"
                               Fill="Transparent" />
                    <Rectangle x:Name="ResizeRight" Width="6" HorizontalAlignment="Right"
                               Cursor="SizeWE" MouseMove="Resize_MouseMove" MouseDown="Resize_MouseDown" MouseUp="Resize_MouseUp"
                               Fill="Transparent" />
                    <Rectangle x:Name="ResizeTop" Height="6" VerticalAlignment="Top"
                               Cursor="SizeNS" MouseMove="Resize_MouseMove" MouseDown="Resize_MouseDown" MouseUp="Resize_MouseUp"
                               Fill="Transparent" />
                    <Rectangle x:Name="ResizeBottom" Height="6" VerticalAlignment="Bottom"
                               Cursor="SizeNS" MouseMove="Resize_MouseMove" MouseDown="Resize_MouseDown" MouseUp="Resize_MouseUp"
                               Fill="Transparent" />
                    <Rectangle x:Name="ResizeTopLeft" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Top"
                               Cursor="SizeNWSE" MouseMove="Resize_MouseMove" MouseDown="Resize_MouseDown" MouseUp="Resize_MouseUp"
                               Fill="Transparent" />
                    <Rectangle x:Name="ResizeTopRight" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Top"
                               Cursor="SizeNESW" MouseMove="Resize_MouseMove" MouseDown="Resize_MouseDown" MouseUp="Resize_MouseUp"
                               Fill="Transparent" />
                    <Rectangle x:Name="ResizeBottomLeft" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                               Cursor="SizeNESW" MouseMove="Resize_MouseMove" MouseDown="Resize_MouseDown" MouseUp="Resize_MouseUp"
                               Fill="Transparent" />
                    <!-- Visual corner gripper (resize handle) -->
                    <Path Data="M 8,12 L 12,8 M 4,12 L 12,4 M 0,12 L 12,0"
                          Stroke="#50FFFFFF" StrokeThickness="1.2"
                          Width="12" Height="12"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          IsHitTestVisible="False" Margin="0,0,3,3"
                          Visibility="{Binding DataContext.ShowDesktopResizeHandle, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Rectangle x:Name="ResizeBottomRight" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Cursor="SizeNWSE" MouseMove="Resize_MouseMove" MouseDown="Resize_MouseDown" MouseUp="Resize_MouseUp"
                               Fill="Transparent" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
