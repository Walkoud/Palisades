                                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Properties_Name]}" Foreground="#999" VerticalAlignment="Center" FontSize="13" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding SelectedContainer.Name, UpdateSourceTrigger=PropertyChanged}"
