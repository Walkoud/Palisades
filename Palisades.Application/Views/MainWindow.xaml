                                <StackPanel>
                                    <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Properties_General]}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="#DDD" Margin="0,0,0,14" />
