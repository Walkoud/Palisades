                                                Foreground="#FF8888" Padding="12,6" FontSize="11"
                                                Cursor="Hand"
                                                Command="{Binding HideAllContainersCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Snapshots -->
                            <Border Background="#252525" CornerRadius="10" Padding="18" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Snapshots_Title]}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="#DDD" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Snapshots_Capture]}"
                                                Background="#2A4A2A" BorderBrush="#4A6A4A" BorderThickness="1"
                                                Foreground="#8D8" Padding="10,5" FontSize="11"
                                                Cursor="Hand" Command="{Binding CreateSnapshotCommand}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Snapshots}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#2A2A2A" CornerRadius="6" Padding="10" Margin="0,3">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="12"
                                                                       FontWeight="Medium" Foreground="#EEE" />
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                                           FontSize="10" Foreground="#777" Margin="0,2,8,0" />
                                                                <TextBlock Text="{Binding Type}" FontSize="10"
                                                                           Foreground="#FFA500" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </StackPanel>
