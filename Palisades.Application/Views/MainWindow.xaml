                                        <Border Background="#5F2D1E" Tag="#FF5F2D1E" MouseDown="HeaderColorSwatch_MouseDown" Cursor="Hand" CornerRadius="3" Margin="1" ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Color_Ember]}" />
                                        <Border Background="#4A1E3A" Tag="#FF4A1E3A" MouseDown="HeaderColorSwatch_MouseDown" Cursor="Hand" CornerRadius="3" Margin="1" ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Color_Berry]}" />
                                        <Border Background="#1E4A5F" Tag="#FF1E4A5F" MouseDown="HeaderColorSwatch_MouseDown" Cursor="Hand" CornerRadius="3" Margin="1" ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Color_Teal]}" />
                                        <Border Background="#151515" Tag="#FF151515" MouseDown="HeaderColorSwatch_MouseDown" Cursor="Hand" CornerRadius="3" Margin="1" ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Color_NearBlack]}" />
                                        <Border Background="#1A1A2E" Tag="#FF1A1A2E" MouseDown="HeaderColorSwatch_MouseDown" Cursor="Hand" CornerRadius="3" Margin="1" ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Color_Midnight]}" />
                                    </UniformGrid>
                                    <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Colors_BodyBg]}" Foreground="#999" Margin="0,0,0,6" FontSize="12" />
                                    <UniformGrid Columns="10" Height="24">
                                        <Border Background="#2D2D2D" Tag="#FF2D2D2D" MouseDown="BodyColorSwatch_MouseDown" Cursor="Hand" CornerRadius="3" Margin="1" ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Color_DarkGrey]}" />
                                        <Border Background="#1E3A5F" Tag="#FF1E3A5F" MouseDown="BodyColorSwatch_MouseDown" Cursor="Hand" CornerRadius="3" Margin="1" ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Color_SteelBlue]}" />
                                        <Border Background="#3A1E5F" Tag="#FF3A1E5F" MouseDown="BodyColorSwatch_MouseDown" Cursor="Hand" CornerRadius="3" Margin="1" ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Color_Plum]}" />
                                        <Border Background="#1E4A3A" Tag="#FF1E4A3A" MouseDown="BodyColorSwatch_MouseDown" Cursor="Hand" CornerRadius="3" Margin="1" ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Color_Pine]}" />
                                        <Border Background="#5F4E1E" Tag="#FF5F4E1E" MouseDown="BodyColorSwatch_MouseDown" Cursor="Hand" CornerRadius="3" Margin="1" ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Color_Bronze]}" />
                                        <Border Background="#5F2D1E" Tag="#FF5F2D1E" MouseDown="BodyColorSwatch_MouseDown" Cursor="Hand" CornerRadius="3" Margin="1" ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Color_Ember]}" />
                                        <Border Background="#4A1E3A" Tag="#FF4A1E3A" MouseDown="BodyColorSwatch_MouseDown" Cursor="Hand" CornerRadius="3" Margin="1" ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Color_Berry]}" />
                                        <Border Background="#1E4A5F" Tag="#FF1E4A5F" MouseDown="BodyColorSwatch_MouseDown" Cursor="Hand" CornerRadius="3" Margin="1" ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Color_Teal]}" />
                                        <Border Background="#151515" Tag="#FF151515" MouseDown="BodyColorSwatch_MouseDown" Cursor="Hand" CornerRadius="3" Margin="1" ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Color_NearBlack]}" />
                                        <Border Background="#1A1A2E" Tag="#FF1A1A2E" MouseDown="BodyColorSwatch_MouseDown" Cursor="Hand" CornerRadius="3" Margin="1" ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Color_Midnight]}" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- Section: Filtre -->
                            <Border Background="#252525" CornerRadius="10" Padding="18" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Filter_Title]}" FontSize="15" FontWeight="SemiBold"
                                                Foreground="#DDD" Margin="0,0,0,14" />
                                    <CheckBox Margin="0,0,0,6" IsChecked="{Binding SelectedContainer.FilterEnabled}"
                                                Foreground="#AAA" FontSize="12">
                                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Filter_Enable]}" Foreground="#AAA" FontSize="12" />
                                    </CheckBox>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Filter_Type]}" Foreground="#999" VerticalAlignment="Center" FontSize="12" />
                                        <ComboBox Grid.Column="1"
                                                  SelectedValue="{Binding SelectedContainer.FilterType}"
                                                  SelectedValuePath="Content"
                                                  Background="#2A2A2A" BorderBrush="#444"
                                                  Foreground="#EEE" FontSize="12">
                                            <ComboBoxItem Content="All" />
                                            <ComboBoxItem Content="Programs" />
                                            <ComboBoxItem Content="Documents" />
                                            <ComboBoxItem Content="Images" />
                                            <ComboBoxItem Content="Videos" />
                                            <ComboBoxItem Content="Music" />
                                            <ComboBoxItem Content="Archives" />
                                            <ComboBoxItem Content="Links" />
                                            <ComboBoxItem Content="Folders" />
                                            <ComboBoxItem Content="Custom" />
                                        </ComboBox>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Filter_Pattern]}" Foreground="#999" VerticalAlignment="Center" FontSize="12" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding SelectedContainer.FilterPattern, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="#2A2A2A" BorderBrush="#444" Foreground="#EEE"
                                                 Padding="6,3" FontSize="12"
                                                 ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Filter_CustomTooltip]}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Folder Portal -->
                            <Border BorderBrush="#2A4A2A" BorderThickness="1" CornerRadius="10" Padding="18"
                                    Margin="0,0,0,10"
                                    Visibility="{Binding SelectedContainer.FolderPortalPath, Converter={StaticResource NullToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[FolderPortal_Title]}" FontSize="15" FontWeight="SemiBold"
                                                Foreground="#8D8" Margin="0,0,0,10" />
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[FolderPortal_Path]}" Foreground="#999"
                                                    VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding SelectedContainer.FolderPortalPath}"
                                                   Foreground="#8D8" FontSize="11"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding SelectedContainer.FolderPortalPath}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[FolderPortal_SyncedContent]}"
                                                Foreground="#555" FontSize="10" FontStyle="Italic" Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[FolderPortal_SyncAll]}"
                                                Background="#3A3A5F" BorderBrush="#555" BorderThickness="1"
                                                Foreground="#CCC" Padding="12,6" FontSize="11"
                                                Margin="0,0,8,0" Cursor="Hand"
                                                Command="{Binding SyncAllFolderPortalsCommand}" />
                                        <Button Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[FolderPortal_ChangeFolder]}"
                                                Background="#2A4A2A" BorderBrush="#4A6A4A" BorderThickness="1"
                                                Foreground="#8D8" Padding="12,6" FontSize="11"
                                                Cursor="Hand"
                                                Command="{Binding SelectedContainer.ChangeFolderPortalPathCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Section: Actions rapides -->
                            <Border Background="#252525" CornerRadius="10" Padding="18" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[QuickActions_Title]}" FontSize="15" FontWeight="SemiBold"
                                                Foreground="#DDD" Margin="0,0,0,10" />
                                     <WrapPanel>
                                         <Button Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[QuickActions_Recenter]}"
                                                 Background="#333" BorderBrush="#555" BorderThickness="1"
                                                 Foreground="#CCC" Padding="12,6" FontSize="12"
                                                 Margin="0,0,8,8" Cursor="Hand"
                                                 Command="{Binding SelectedContainer.RecenterCommand}" />
                                         <Button Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[QuickActions_SnapToGrid]}"
                                                 Background="#3A3A5F" BorderBrush="#555" BorderThickness="1"
                                                 Foreground="#CCC" Padding="12,6" FontSize="12"
                                                 Margin="0,0,8,8" Cursor="Hand"
                                                 Command="{Binding SelectedContainer.ResizeToIconMultiplesCommand}" />
                                         <Button Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[QuickActions_ApplyToAll]}"
                                                 Background="#3A3A5F" BorderBrush="#555" BorderThickness="1"
                                                 Foreground="#CCC" Padding="12,6" FontSize="12"
                                                 Margin="0,0,8,8" Cursor="Hand"
                                                 Command="{Binding ApplyOptionsToAllCommand}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===== STATUS BAR ===== -->
            <Border Grid.Row="3" Background="#1E1E1E" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0">
                <TextBlock x:Name="StatusText" Foreground="#777" FontSize="11"
                           VerticalAlignment="Center" Margin="14,0" />
            </Border>

        </Grid>
    </Border>
</Window>