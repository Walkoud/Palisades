<Window x:Class="Palisades.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Palisades.ViewModels"
        xmlns:conv="clr-namespace:Palisades.Converters"
        xmlns:svc="clr-namespace:Palisades.Services"
        mc:Ignorable="d"
        Title="Palisades"
        Height="700" Width="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        MinWidth="800" MinHeight="500"
        d:DataContext="{d:DesignInstance vm:MainViewModel}">
    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <conv:InvertBoolConverter x:Key="InvertBoolConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:EqualsConverter x:Key="EqualsConverter" />
        <conv:IsInListConverter x:Key="IsInListConverter" />
        <conv:FilePathToImageConverter x:Key="FilePathToImage" />
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" CornerRadius="12" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12" Background="#1A1A1A" BorderBrush="#333" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>

            <!-- ===== TITLE BAR ===== -->
            <Grid Grid.Row="0" Background="#222" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Palisades" FontSize="16" FontWeight="Bold"
                           Foreground="#EEE" Margin="16,0,0,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="—" Width="40" Height="30"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#AAA" FontSize="16"
                            Click="Minimize_Click" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#333333" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="✕" Width="40" Height="30"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#CCC" FontSize="15"
                            Click="Close_Click" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#CC3333" />
                                        <Setter Property="Foreground" Value="#FFF" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===== TOOLBAR ===== -->
            <Border Grid.Row="1" Background="#1E1E1E" BorderBrush="#333" BorderThickness="0,0,0,1" Height="36">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Toolbar_Home]}" Command="{Binding NavigateHomeCommand}"
                            Background="Transparent" BorderThickness="0" Foreground="#AAA" FontSize="12"
                            Padding="12,0" Cursor="Hand"
                            ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Tooltip_Home]}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#33FFFFFF" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Separator Grid.Column="1" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="0,6" Background="#444" />
                    <Button Grid.Column="2" Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Toolbar_New]}" Command="{Binding CreateContainerCommand}"
                            Background="Transparent" BorderThickness="0" Foreground="#AAA" FontSize="12"
                            Padding="12,0" Cursor="Hand"
                            ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Tooltip_New]}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#33FFFFFF" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Separator Grid.Column="3" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="0,6" Background="#444" />
                    <Button Grid.Column="4" Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Toolbar_Show]}" Command="{Binding ShowAllContainersCommand}"
                            Background="Transparent" BorderThickness="0" Foreground="#AAA" FontSize="12"
                            Padding="12,0" Cursor="Hand" ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Tooltip_Show]}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#33FFFFFF" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Grid.Column="5" Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Toolbar_Hide]}" Command="{Binding HideAllContainersCommand}"
                            Background="Transparent" BorderThickness="0" Foreground="#AAA" FontSize="12"
                            Padding="12,0" Cursor="Hand" ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Tooltip_Hide]}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#33FFFFFF" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Separator Grid.Column="6" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="0,6" Background="#444" />
                    <Button Grid.Column="7" x:Name="ActionsButton" Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Toolbar_Actions]}"
                            Background="Transparent" BorderThickness="0" Foreground="#AAA" FontSize="12"
                            Padding="12,0" Cursor="Hand" Click="ActionsButton_Click"
                            ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Tooltip_Actions]}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#33FFFFFF" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Popup x:Name="ActionsPopup" PlacementTarget="{Binding ElementName=ActionsButton}"
                           Placement="Bottom" AllowsTransparency="True"
                           StaysOpen="False" IsOpen="False"
                           PopupAnimation="Fade">
                        <Border Background="#1E1E1E" BorderBrush="#333" BorderThickness="1"
                                CornerRadius="6" Padding="4">
                            <StackPanel TextElement.Foreground="#EEE" TextElement.FontSize="12">
                                <StackPanel.Resources>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Foreground" Value="#EEE" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Padding" Value="8,4" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#33FFFFFF" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Resources>
                                <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[ActionsMenu_SortAll]}" Command="{Binding DataContext.SortAllCommand, Source={x:Reference ActionsButton}}" />
                                <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[ActionsMenu_SortNew]}" Command="{Binding DataContext.SortUnassignedCommand, Source={x:Reference ActionsButton}}" />
                                <Separator Background="#444" />
                                <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[ActionsMenu_SyncPortal]}" Command="{Binding DataContext.SyncAllFolderPortalsCommand, Source={x:Reference ActionsButton}}" />
                                <MenuItem Header="{Binding DataContext.ToggleIconsText, Source={x:Reference ActionsButton}}" Command="{Binding DataContext.ToggleIconsCommand, Source={x:Reference ActionsButton}}" />
                                <Separator Background="#444" />
                                <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[ActionsMenu_Snapshotter]}" Command="{Binding DataContext.CreateSnapshotCommand, Source={x:Reference ActionsButton}}" />
                                <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[ActionsMenu_StartWithWindows]}" IsCheckable="True"
                                          IsChecked="{Binding DataContext.IsStartupEnabled, Source={x:Reference ActionsButton}, Mode=OneWay}"
                                          Command="{Binding DataContext.ToggleStartupCommand, Source={x:Reference ActionsButton}}" />
                                <Separator Background="#444" />
                                <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[ActionsMenu_ApplyToAll]}" Command="{Binding DataContext.ApplyOptionsToAllCommand, Source={x:Reference ActionsButton}}" />
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Separator Grid.Column="8" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="0,6" Background="#444" />
                    <Button Grid.Column="9" Content="Arctic"
                            Background="Transparent" BorderThickness="0" Foreground="#7DD3FC" FontSize="12"
                            Padding="12,0" Cursor="Hand" Click="ArcticShelter_Click"
                            ToolTip="Open Arctic Shelter theme settings">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#337DD3FC" />
                                        <Setter Property="Foreground" Value="#FFF" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- ===== BODY ===== -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ===== LEFT SIDEBAR ===== -->
                <Border Grid.Column="0" Background="#1E1E1E" BorderBrush="#2A2A2A" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Container List -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,4">
                            <ItemsControl ItemsSource="{Binding Containers}" Margin="8,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#252525" CornerRadius="8"
                                                Margin="0,3" Padding="0" Cursor="Hand"
                                                MouseDown="ContainerItem_MouseDown">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Color accent bar -->
                                                <Border Grid.Column="0" CornerRadius="2,0,0,2"
                                                        Background="{Binding HeaderColor}" />
                                                <StackPanel Grid.Column="1" Margin="10,8">
                                                    <TextBlock Text="{Binding Name}" FontSize="13"
                                                               FontWeight="Medium" Foreground="#EEE" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock Text="{Binding Shortcuts.Count, StringFormat={}{0} éléments}"
                                                                   FontSize="11" Foreground="#777" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                            VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <Button Content="..." Width="22" Height="22"
                                                            Background="#33FFFFFF" BorderThickness="0"
                                                            Foreground="#AAA" FontSize="14"
                                                            ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Sidebar_Edit]}"
                                                            Command="{Binding EditCommand}" />
                                                    <Button Content="✕" Width="22" Height="22"
                                                            Background="#33FF0000" BorderThickness="0"
                                                            Foreground="#FF6666" FontSize="10"
                                                            ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Sidebar_Delete]}"
                                                            Command="{Binding DeleteCommand}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Bottom: Options -->
                        <StackPanel Grid.Row="3" Margin="12,4,12,10">
                            <Separator Background="#444" Margin="0,6" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Lang_Label]}" Foreground="#AAA" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox Grid.Column="1" x:Name="LanguageCombo"
                                          SelectedIndex="{Binding LanguageIndex}"
                                          Background="#252525" Foreground="#EEE"
                                          BorderBrush="#444" FontSize="11"
                                          SelectionChanged="LanguageCombo_SelectionChanged">
                                    <ComboBoxItem Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Lang_English]}" Tag="en" />
                                    <ComboBoxItem Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Lang_French]}" Tag="fr" />
                                </ComboBox>
                            </Grid>
                            <Separator Background="#444" Margin="0,6" />
                            <Button Content="{Binding ToggleIconsText}"
                                    Height="30" Background="#252525"
                                    BorderThickness="1" BorderBrush="#333"
                                    Foreground="#AAA" FontSize="11"
                                    Cursor="Hand" Command="{Binding ToggleIconsCommand}" />
                            <CheckBox Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Sidebar_AutoSortNew]}"
                                      IsChecked="{Binding IsAutoSortEnabled}"
                                      Margin="0,6,0,0"
                                      Foreground="#AAA" FontSize="11"
                                      Cursor="Hand" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                        Visibility="{Binding IsAutoSortEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Sidebar_Destination]}" Foreground="#AAA" FontSize="11"
                                           VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding DestinationOptions}"
                                          SelectedValue="{Binding AutoSortTargetIdentifier}"
                                          SelectedValuePath="Identifier"
                                          DisplayMemberPath="Name"
                                          Width="140" Height="24"
                                          Background="#252525" Foreground="#EEE"
                                          BorderBrush="#444" FontSize="11">
                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="Foreground" Value="#EEE" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDesktop}" Value="True">
                                                    <Setter Property="Foreground" Value="#4CAF50" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>
                                </ComboBox>
                            </StackPanel>
                            <CheckBox Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Sidebar_AutoSnapshot]}"
                                      IsChecked="{Binding IsAutoSnapshotEnabled}"
                                      Margin="0,4,0,0"
                                      Foreground="#AAA" FontSize="11"
                                      Cursor="Hand" />
                            <CheckBox Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Sidebar_ShowShortcutArrow]}"
                                      IsChecked="{Binding ShowDesktopShortcutArrow}"
                                      Margin="0,4,0,0"
                                      Foreground="#AAA" FontSize="11"
                                      Cursor="Hand" />
                            <CheckBox Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Sidebar_ShowRecycleBin]}"
                                      IsChecked="{Binding ShowRecycleBin}"
                                      Margin="0,4,0,0"
                                      Foreground="#AAA" FontSize="11"
                                      Cursor="Hand" />
                            <Button Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Sidebar_Export]}"
                                    Height="28" Background="#252525" BorderThickness="1"
                                    BorderBrush="#333" Foreground="#AAA" FontSize="11"
                                    Margin="0,6,0,0" Cursor="Hand"
                                    Command="{Binding ExportConfigCommand}" />
                            <Button Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Sidebar_Import]}"
                                    Height="28" Background="#252525" BorderThickness="1"
                                    BorderBrush="#333" Foreground="#AAA" FontSize="11"
                                    Margin="0,4,0,0" Cursor="Hand"
                                    Command="{Binding ImportConfigCommand}" />
                            <Button Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Sidebar_HardReset]}"
                                    Height="28" Background="#3A1A1A" BorderThickness="1"
                                    BorderBrush="#633" Foreground="#E66" FontSize="11"
                                    Margin="0,6,0,0" Cursor="Hand"
                                    Command="{Binding HardResetCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== RIGHT PANEL ===== -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                              Background="#1A1A1A" HorizontalScrollBarVisibility="Disabled"
                              Padding="16,12">
                    <StackPanel>

                        <!-- ===== HOME VIEW (no container selected) ===== -->
                        <StackPanel x:Name="HomePanel">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedContainer}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Welcome -->
                            <Border Background="#252525" CornerRadius="10" Padding="24" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Palisades" FontSize="22" FontWeight="Bold"
                                               Foreground="#EEE" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Welcome_Title]}"
                                               FontSize="13" Foreground="#777"
                                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                                    <Button Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Welcome_CreateContainer]}"
                                            Background="#2A4A2A" BorderBrush="#4A6A4A" BorderThickness="1"
                                            Foreground="#8D8" Padding="14,8" FontSize="13"
                                            HorizontalAlignment="Center" Margin="0,14,0,0"
                                            Cursor="Hand" Command="{Binding CreateContainerCommand}" />
                                </StackPanel>
                            </Border>

                            <!-- Default Options pour nouveaux conteneurs -->
                            <Border Background="#252525" CornerRadius="10" Padding="18" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[DefaultOptions_Title]}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="#DDD" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[DefaultOptions_Save]}"
                                                Background="#2A4A2A" BorderBrush="#4A6A4A" BorderThickness="1"
                                                Foreground="#8D8" Padding="12,6" FontSize="11"
                                                Cursor="Hand" Command="{Binding SaveDefaultOptionsCommand}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[DefaultOptions_Description]}"
                                               Foreground="#666" FontSize="11" FontStyle="Italic" Margin="0,0,0,8" />

                                    <!-- Preview container selector -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[DefaultOptions_LivePreview]}" Foreground="#999" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,0" />
                                        <ComboBox Grid.Column="1"
                                                  x:Name="PreviewContainerCombo"
                                                  ItemsSource="{Binding Containers}"
                                                  DisplayMemberPath="Name"
                                                  Background="#2A2A2A" BorderBrush="#444"
                                                  Foreground="#EEE" FontSize="11" />
                                        <CheckBox Grid.Column="2" x:Name="LivePreviewToggle"
                                                  Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[DefaultOptions_LivePreview]}" IsChecked="True"
                                                  Foreground="#8D8" FontSize="11" Margin="6,0,0,0" />
                                    </Grid>
                                    <!-- Import defaults from an existing container -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[DefaultOptions_ImportFrom]}" Foreground="#999" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,0" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding Containers}"
                                                  DisplayMemberPath="Name"
                                                  SelectedItem="{Binding ImportSourceContainer}"
                                                  Background="#2A2A2A" BorderBrush="#444"
                                                  Foreground="#EEE" FontSize="11" />
                                        <Button Grid.Column="2" Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[DefaultOptions_Import]}"
                                                Background="#3A3A5F" BorderBrush="#555" BorderThickness="1"
                                                Foreground="#CCC" Padding="10,4" FontSize="11"
                                                Margin="6,0,0,0" Cursor="Hand"
                                                Command="{Binding ImportDefaultsFromContainerCommand}" />
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="45" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[DefaultOptions_OpacityInactive]}" Foreground="#999" VerticalAlignment="Center" FontSize="12" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="100"
                                                Value="{Binding DefaultModel.IdleOpacity, Mode=TwoWay}"
                                                TickFrequency="5" IsSnapToTickEnabled="True"
                                                Tag="IdleOpacity"
                                                ValueChanged="DefaultSlider_ValueChanged" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding DefaultModel.IdleOpacity, StringFormat={}{0:F0}%}"
                                                   Foreground="#999" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" />
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="45" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[DefaultOptions_OpacityActive]}" Foreground="#999" VerticalAlignment="Center" FontSize="12" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="100"
                                                Value="{Binding DefaultModel.ActiveOpacity, Mode=TwoWay}"
                                                TickFrequency="5" IsSnapToTickEnabled="True"
                                                Tag="ActiveOpacity"
                                                ValueChanged="DefaultSlider_ValueChanged" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding DefaultModel.ActiveOpacity, StringFormat={}{0:F0}%}"
                                                   Foreground="#999" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" />
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[DefaultOptions_ViewMode]}" Foreground="#999" VerticalAlignment="Center" FontSize="12" />
                                        <ComboBox Grid.Column="1"
                                                  SelectedValue="{Binding DefaultModel.ViewMode}"
                                                  SelectedValuePath="Tag"
                                                  Tag="ViewMode" SelectionChanged="DefaultComboBox_Changed"
                                                  Background="#2A2A2A" BorderBrush="#444"
                                                  Foreground="#EEE" FontSize="12">
                                            <ComboBoxItem Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[DefaultOptions_Icons]}" Tag="Icons" />
