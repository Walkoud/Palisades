                                        <Border Background="#5F2D1E" Tag="#FF5F2D1E" MouseDown="DefaultHeaderColorSwatch_MouseDown" Cursor="Hand" CornerRadius="3" Margin="1" ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Color_Ember]}" />
                                        <Border Background="#4A1E3A" Tag="#FF4A1E3A" MouseDown="DefaultHeaderColorSwatch_MouseDown" Cursor="Hand" CornerRadius="3" Margin="1" ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Color_Berry]}" />
                                        <Border Background="#1E4A5F" Tag="#FF1E4A5F" MouseDown="DefaultHeaderColorSwatch_MouseDown" Cursor="Hand" CornerRadius="3" Margin="1" ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Color_Teal]}" />
                                        <Border Background="#151515" Tag="#FF151515" MouseDown="DefaultHeaderColorSwatch_MouseDown" Cursor="Hand" CornerRadius="3" Margin="1" ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Color_NearBlack]}" />
                                        <Border Background="#1A1A2E" Tag="#FF1A1A2E" MouseDown="DefaultHeaderColorSwatch_MouseDown" Cursor="Hand" CornerRadius="3" Margin="1" ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Color_Midnight]}" />
                                    </UniformGrid>
                                    <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Colors_BodyBg]}" Foreground="#999" Margin="0,0,0,6" FontSize="12" />
