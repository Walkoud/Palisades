                                        <Border Background="#2D2D2D" Tag="#FF2D2D2D" MouseDown="DefaultBodyColorSwatch_MouseDown" Cursor="Hand" CornerRadius="3" Margin="1" ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Color_DarkGrey]}" />
                                        <Border Background="#1E3A5F" Tag="#FF1E3A5F" MouseDown="DefaultBodyColorSwatch_MouseDown" Cursor="Hand" CornerRadius="3" Margin="1" ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Color_SteelBlue]}" />
                                        <Border Background="#3A1E5F" Tag="#FF3A1E5F" MouseDown="DefaultBodyColorSwatch_MouseDown" Cursor="Hand" CornerRadius="3" Margin="1" ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Color_Plum]}" />
                                        <Border Background="#1E4A3A" Tag="#FF1E4A3A" MouseDown="DefaultBodyColorSwatch_MouseDown" Cursor="Hand" CornerRadius="3" Margin="1" ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Color_Pine]}" />
                                        <Border Background="#5F4E1E" Tag="#FF5F4E1E" MouseDown="DefaultBodyColorSwatch_MouseDown" Cursor="Hand" CornerRadius="3" Margin="1" ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Color_Bronze]}" />
                                        <Border Background="#5F2D1E" Tag="#FF5F2D1E" MouseDown="DefaultBodyColorSwatch_MouseDown" Cursor="Hand" CornerRadius="3" Margin="1" ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Color_Ember]}" />
                                        <Border Background="#4A1E3A" Tag="#FF4A1E3A" MouseDown="DefaultBodyColorSwatch_MouseDown" Cursor="Hand" CornerRadius="3" Margin="1" ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Color_Berry]}" />
                                        <Border Background="#1E4A5F" Tag="#FF1E4A5F" MouseDown="DefaultBodyColorSwatch_MouseDown" Cursor="Hand" CornerRadius="3" Margin="1" ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Color_Teal]}" />
                                        <Border Background="#151515" Tag="#FF151515" MouseDown="DefaultBodyColorSwatch_MouseDown" Cursor="Hand" CornerRadius="3" Margin="1" ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Color_NearBlack]}" />
                                        <Border Background="#1A1A2E" Tag="#FF1A1A2E" MouseDown="DefaultBodyColorSwatch_MouseDown" Cursor="Hand" CornerRadius="3" Margin="1" ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Color_Midnight]}" />
                                    </UniformGrid>
                                </StackPanel>
