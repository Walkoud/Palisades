                                    <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Theme_Title]}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="#DDD" Margin="0,0,0,14" />
                                    <CheckBox Margin="0,0,0,6" IsChecked="{Binding IsDarkMode}"
                                              Foreground="#AAA" FontSize="12">
                                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Theme_DarkMode]}" Foreground="#AAA" FontSize="12" />
                                    </CheckBox>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Theme_Preset]}" Foreground="#999" VerticalAlignment="Center" FontSize="12" />
