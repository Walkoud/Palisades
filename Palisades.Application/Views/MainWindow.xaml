                                        <Border Background="#3A1E5F" Tag="#FF3A1E5F" MouseDown="DefaultHeaderColorSwatch_MouseDown" Cursor="Hand" CornerRadius="3" Margin="1" ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Color_Plum]}" />
