<Window x:Class="Palisades.Views.ContainerWindow"
        x:Name="ThisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Palisades.ViewModels"
        xmlns:conv="clr-namespace:Palisades.Converters"
        xmlns:controls="clr-namespace:Palisades.Views.Controls"
        xmlns:dd="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.WPF.DragDrop"
        xmlns:local="clr-namespace:Palisades.Views"
         xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
         xmlns:svc="clr-namespace:Palisades.Services"
        mc:Ignorable="d"
        local:ContainerVisuals.ShowShortcutArrow="{Binding ShowShortcutArrow}"
        ShowInTaskbar="False"
        WindowStyle="None"
        Background="#FF181818"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Width="{Binding Width}"
        Height="{Binding Height}"
        Left="{Binding X}"
        Top="{Binding Y}"
        Opacity="{Binding CurrentOpacity, Mode=OneWay}"
        d:DataContext="{d:DesignInstance vm:ContainerViewModel}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0"
                            CornerRadius="{Binding CornerRadius, ElementName=MainBorder}"
                            CaptionHeight="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <conv:PathToImageConverter x:Key="IconConverter" ShowArrow="True" />
        <conv:PathToImageConverter x:Key="IconNoArrowConverter" ShowArrow="False" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:InvertBoolConverter x:Key="InvertBoolConverter" />
        <conv:EqualsConverter x:Key="EqualsConverter" />
        <conv:BorderThicknessConverter x:Key="BorderThicknessConverter" />
        <controls:ShortcutReorderHandler x:Key="ReorderHandler" />
        <conv:BindingProxy x:Key="VmProxy" Data="{Binding}" />
        <CollectionViewSource x:Key="ShortcutsView" Source="{Binding Shortcuts}" />

        <!-- Thin scrollbar style (Windows 11 Fluent) - implicit, applies to all ScrollBars -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Root" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Background="Transparent" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Background="Transparent" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Margin="0,1">
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Width" Value="4" />
                                                <Setter Property="Background" Value="#40FFFFFF" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    CornerRadius="3" />
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Width" Value="6" />
                                                        <Setter Property="Background" Value="#80FFFFFF" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter Property="Width" Value="6" />
                                                        <Setter Property="Background" Value="#AAFFFFFF" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Thumb" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Delete" Command="{Binding DeleteShortcutCommand}" />
    </Window.InputBindings>

    <Window.ContextMenu>
        <ContextMenu Background="#2A2A2A" Foreground="#EEE" BorderBrush="#444" BorderThickness="1">
            <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Container_ContextMenu_Lock]}" Command="{Binding ToggleLockCommand}" />
            <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Container_ContextMenu_AutoHide]}" Command="{Binding ToggleAutoHideCommand}" />
            <Separator Background="#444" />
            <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Container_ContextMenu_EditProperties]}" Command="{Binding EditCommand}" />
            <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Container_ContextMenu_DeleteContainer]}" Command="{Binding DeleteCommand}" />
        </ContextMenu>
    </Window.ContextMenu>

    <Grid Margin="7">
    <Border x:Name="MainBorder"
            MouseEnter="MainBorder_MouseEnter"
            MouseLeave="MainBorder_MouseLeave"
            MouseRightButtonUp="MainBorder_RightClick"
            AllowDrop="True"
            Drop="MainBorder_Drop">
        <Border.Style>
        <Style TargetType="Border">
            <Setter Property="BorderBrush" Value="#25FFFFFF" />
            <Setter Property="CornerRadius" Value="{Binding CornerRadius}" />
            <Setter Property="BorderThickness" Value="{Binding ShowBorder, Converter={StaticResource BorderThicknessConverter}}" />
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="{Binding BodyColor}" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHovered}" Value="True">
                    <Setter Property="BorderBrush" Value="#45FFFFFF" />
                </DataTrigger>
                
                <!-- Global Theme Active -->
                <DataTrigger Binding="{Binding IsThemeActive}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ContainerBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ContainerBorderBrush}" />
                    <Setter Property="BorderThickness" Value="{DynamicResource ContainerBorderThickness}" />
                    <Setter Property="CornerRadius" Value="{DynamicResource ContainerCornerRadius}" />
                </DataTrigger>
                
                <!-- Global Theme Hover -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsThemeActive}" Value="True" />
                        <Condition Binding="{Binding IsHovered}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{DynamicResource ContainerBorderBrushHover}" />
                </MultiDataTrigger>
                
                <!-- User Options Overrides for Global Theme -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsThemeActive}" Value="True" />
                        <Condition Binding="{Binding ShowBorder}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderThickness" Value="0" />
                </MultiDataTrigger>
                
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsThemeActive}" Value="True" />
                        <Condition Binding="{Binding RoundedCornersEnabled}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="CornerRadius" Value="0" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header / Title Bar (iTop-like) -->
            <Grid Grid.Row="0"
                  Height="34"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown"
                  MouseEnter="HeaderBar_MouseEnter"
                  MouseLeave="HeaderBar_MouseLeave"
                  Visibility="{Binding ShowTitleVisibility}"
                  x:Name="HeaderBar">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Rectangle Grid.ColumnSpan="3" IsHitTestVisible="False" RadiusY="0" RadiusX="0">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Fill">
                                <Setter.Value>
                                    <SolidColorBrush Color="{Binding HeaderColor}" />
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTitleHovered}" Value="True">
                                    <Setter Property="Fill" Value="#FF303030" />
                                </DataTrigger>
                                
                                <!-- Global Theme Active -->
                                <DataTrigger Binding="{Binding IsThemeActive}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource ContainerHeaderBrush}" />
                                </DataTrigger>
                                
                                <!-- Global Theme Hover -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsThemeActive}" Value="True" />
                                        <Condition Binding="{Binding IsTitleHovered}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Fill" Value="{DynamicResource ContainerHeaderBrushHover}" />
                                </MultiDataTrigger>
                                <!-- Curtain closed: make background transparent so only title shows -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsCurtainMode}" Value="True" />
                                        <Condition Binding="{Binding IsVisuallyCollapsed}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Fill" Value="Transparent" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>

                <!-- Center: Title / Search hybrid -->
                <Grid Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Title TextBlock (visible when not searching) -->
                    <TextBlock Text="{Binding HeaderText}"
                               FontFamily="{Binding TitleFontFamily}"
                               FontSize="{Binding TitleFontSize}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               IsHitTestVisible="True"
                               MouseDown="TitleTextBlock_MouseDown">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground">
                                    <Setter.Value>
                                        <SolidColorBrush Color="{Binding TitleColor}" />
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSearchActive}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsEditingTitle}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <!-- Global Theme Active -->
                                    <DataTrigger Binding="{Binding IsThemeActive}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource ContainerTitleForeground}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Search TextBox (pill design, visible when searching) -->
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{Binding TitleFontFamily}"
                             FontSize="{Binding TitleFontSize}"
                             FontWeight="SemiBold"
                             Background="#33FFFFFF" BorderBrush="#66FFFFFF"
                             BorderThickness="1"
                             Padding="6,1"
                             Foreground="#FFF"
                             KeyDown="SearchBox_KeyDown"
                             LostFocus="SearchBox_LostFocus"
                             IsHitTestVisible="True">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border x:Name="border" CornerRadius="10"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="⌕" FontSize="11"
                                                               Foreground="#88FFFFFF"
                                                               VerticalAlignment="Center" Margin="0,0,4,0" />
                                                    <ScrollViewer Grid.Column="1" x:Name="PART_ContentHost"
                                                                  VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSearchActive}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Rename TextBox -->
                    <TextBox x:Name="TitleEditBox"
                             Text="{Binding EditingTitle, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                             Background="#33FFFFFF" BorderBrush="#66FFFFFF"
                             BorderThickness="1" Padding="2,1"
                             Foreground="#FFF"
                             KeyDown="TitleEdit_KeyDown"
                             LostFocus="TitleEdit_LostFocus"
                             IsHitTestVisible="True">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditingTitle}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>

                <!-- Left: Hamburger + Search buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVisuallyCollapsed}" Value="True">
                                    <Setter Property="Opacity" Value="0" />
                                    <Setter Property="IsHitTestVisible" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Width="34" Height="30" Margin="2,0,0,0" Padding="1"
                            Background="Transparent" BorderThickness="0"
                            ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Container_Tooltip_Menu]}"
                            Click="HamburgerButton_Click">
                        <Viewbox Stretch="Uniform"
                                 Width="{Binding HeaderIconSize}"
                                 Height="{Binding HeaderIconSize}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                            <Grid Width="9" Height="9">
                                <Path Data="M0,1 L9,1 M0,4.5 L9,4.5 M0,8 L9,8"
                                      Stroke="White" StrokeThickness="1.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Grid>
                        </Viewbox>
                        <Button.ContextMenu>
                            <ContextMenu Background="#2A2A2A" Foreground="#EEE" BorderBrush="#444" BorderThickness="1">
                                <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_CreateShortcut]}" Command="{Binding Data.CreateShortcutCommand, Source={StaticResource VmProxy}}" />
                                <Separator Background="#444" />
                                <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Display]}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="🎨" FontSize="14" />
                                    </MenuItem.Icon>
                                    <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Filter]}">
                                        <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_All]}" IsCheckable="True"
                                                  IsChecked="{Binding Data.FilterType, Source={StaticResource VmProxy}, Converter={StaticResource EqualsConverter}, ConverterParameter=All}"
                                                  Command="{Binding Data.ToggleOptionCommand, Source={StaticResource VmProxy}}" CommandParameter="FilterAll" />
                                        <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Programs]}" IsCheckable="True"
                                                  IsChecked="{Binding Data.FilterType, Source={StaticResource VmProxy}, Converter={StaticResource EqualsConverter}, ConverterParameter=Programs}"
                                                  Command="{Binding Data.ToggleOptionCommand, Source={StaticResource VmProxy}}" CommandParameter="FilterPrograms" />
                                        <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Documents]}" IsCheckable="True"
                                                  IsChecked="{Binding Data.FilterType, Source={StaticResource VmProxy}, Converter={StaticResource EqualsConverter}, ConverterParameter=Documents}"
                                                  Command="{Binding Data.ToggleOptionCommand, Source={StaticResource VmProxy}}" CommandParameter="FilterDocuments" />
                                        <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Folders]}" IsCheckable="True"
                                                  IsChecked="{Binding Data.FilterType, Source={StaticResource VmProxy}, Converter={StaticResource EqualsConverter}, ConverterParameter=Folders}"
                                                  Command="{Binding Data.ToggleOptionCommand, Source={StaticResource VmProxy}}" CommandParameter="FilterFolders" />
                                    </MenuItem>
                                    <Separator Background="#444" />
                                    <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_ShowCounters]}" IsCheckable="True"
                                              IsChecked="{Binding Data.ShowCounter, Source={StaticResource VmProxy}}"
                                              Command="{Binding Data.ToggleOptionCommand, Source={StaticResource VmProxy}}" CommandParameter="ShowCounter" />
                                    <Separator Background="#444" />
                                    <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_ViewMode]}">
                                        <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Icons]}" IsCheckable="True"
                                                  IsChecked="{Binding Data.IsDetailsView, Source={StaticResource VmProxy}, Converter={StaticResource InvertBoolConverter}, Mode=OneWay}"
                                                  Command="{Binding Data.ToggleOptionCommand, Source={StaticResource VmProxy}}" CommandParameter="IconsView" />
                                        <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Details]}" IsCheckable="True"
                                                  IsChecked="{Binding Data.IsDetailsView, Source={StaticResource VmProxy}, Mode=OneWay}"
                                                  Command="{Binding Data.ToggleOptionCommand, Source={StaticResource VmProxy}}" CommandParameter="DetailsView" />
                                    </MenuItem>
                                    <Separator Background="#444" />
                                    <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_IconSize]}">
                                        <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Small]}" Command="{Binding Data.SetIconSizeCommand, Source={StaticResource VmProxy}}" CommandParameter="24" />
                                        <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Medium]}" Command="{Binding Data.SetIconSizeCommand, Source={StaticResource VmProxy}}" CommandParameter="36" />
                                        <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Large]}" Command="{Binding Data.SetIconSizeCommand, Source={StaticResource VmProxy}}" CommandParameter="48" />
                                        <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_XLarge]}" Command="{Binding Data.SetIconSizeCommand, Source={StaticResource VmProxy}}" CommandParameter="64" />
                                    </MenuItem>
                                </MenuItem>
                                <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Options]}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="⚙" FontSize="14" />
                                    </MenuItem.Icon>
                                    <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_AutoHide]}" IsCheckable="True"
                                              IsChecked="{Binding Data.AutoHide, Source={StaticResource VmProxy}}"
                                              Command="{Binding Data.ToggleOptionCommand, Source={StaticResource VmProxy}}" CommandParameter="AutoHide" />
                                    <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Lock]}" IsCheckable="True"
                                              IsChecked="{Binding Data.IsLocked, Source={StaticResource VmProxy}}"
                                              Command="{Binding Data.ToggleOptionCommand, Source={StaticResource VmProxy}}" CommandParameter="IsLocked" />
                                    <Separator Background="#444" />
                                    <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_RoundedCorners]}" IsCheckable="True"
                                              IsChecked="{Binding Data.RoundedCornersEnabled, Source={StaticResource VmProxy}}"
                                              Command="{Binding Data.ToggleOptionCommand, Source={StaticResource VmProxy}}" CommandParameter="RoundedCorners" />
                                    <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_TitleBarHighlight]}" IsCheckable="True"
                                              IsChecked="{Binding Data.TitleHoverEffect, Source={StaticResource VmProxy}}"
                                              Command="{Binding Data.ToggleOptionCommand, Source={StaticResource VmProxy}}" CommandParameter="TitleHoverEffect" />
                                    <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Border]}" IsCheckable="True"
                                              IsChecked="{Binding Data.ShowBorder, Source={StaticResource VmProxy}}"
                                              Command="{Binding Data.ToggleOptionCommand, Source={StaticResource VmProxy}}" CommandParameter="ShowBorder" />
                                    <Separator Background="#444" />
                                    <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_AnimationSpeed]}">
                                        <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Fast]}" Command="{Binding Data.SetAnimationSpeedCommand, Source={StaticResource VmProxy}}" CommandParameter="200" />
                                        <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Normal]}" Command="{Binding Data.SetAnimationSpeedCommand, Source={StaticResource VmProxy}}" CommandParameter="400" />
                                        <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Slow]}" Command="{Binding Data.SetAnimationSpeedCommand, Source={StaticResource VmProxy}}" CommandParameter="600" />
                                    </MenuItem>
                                </MenuItem>
                                <Separator Background="#444" />
                                <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Actions]}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="⚡" FontSize="14" />
                                    </MenuItem.Icon>
                                    <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_SortAll]}" Command="{Binding Data.SortNowCommand, Source={StaticResource VmProxy}}" />
                                    <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Refresh]}" Command="{Binding Data.RefreshCommand, Source={StaticResource VmProxy}}" />
                                    <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Rename]}" Command="{Binding Data.RenameCommand, Source={StaticResource VmProxy}}" />
                                </MenuItem>
                                <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Config]}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="🔧" FontSize="14" />
                                    </MenuItem.Icon>
                                    <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Settings]}" Command="{Binding Data.EditCommand, Source={StaticResource VmProxy}}" />
                                    <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_SortRules]}" Click="HamburgerMenuItem_Click" CommandParameter="Rules" />
                                    <Separator Background="#444" />
                                    <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_SetAsDefault]}" Command="{Binding Data.SetAsDefaultCommand, Source={StaticResource VmProxy}}" />
                                </MenuItem>
                                <Separator Background="#444" />
                                <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Hamburger_Delete]}" Command="{Binding Data.DeleteCommand, Source={StaticResource VmProxy}}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Width="30" Height="30" Margin="0,0,0,0" Padding="1"
                            Background="Transparent" BorderThickness="0"
                            ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Container_Tooltip_Search]}"
                            Click="SearchButton_Click">
                        <Viewbox Stretch="Uniform"
                                 Width="{Binding HeaderIconSize}"
                                 Height="{Binding HeaderIconSize}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                            <Grid Width="9" Height="9">
                                <Path Data="M1.5,3.5 A2.5,2.5 0 1,1 6.5,3.5 A2.5,2.5 0 1,1 1.5,3.5 M5.5,5.5 L8,8"
                                      Stroke="White" StrokeThickness="1.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Grid>
                        </Viewbox>
                    </Button>
                </StackPanel>

                <!-- Right: Lock + Chevron buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVisuallyCollapsed}" Value="True">
                                    <Setter Property="Opacity" Value="0" />
                                    <Setter Property="IsHitTestVisible" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Width="30" Height="30" Margin="0,0,0,0" Padding="1"
                            Background="Transparent" BorderThickness="0"
                            ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Container_Tooltip_LockContainer]}"
                            Click="LockBoxButton_Click"
                            Visibility="{Binding CanLockPrivateBox, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Viewbox Stretch="Uniform"
                                 Width="{Binding HeaderIconSize}"
                                 Height="{Binding HeaderIconSize}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                            <Grid Width="9" Height="9">
                                <Path Data="M3,4 V2.5 A1.5,1.5 0 1,1 6,2.5 V4 M2,4 H7 V8 H2 Z M4.5,5 L4.5,7"
                                      Stroke="White" StrokeThickness="1.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Grid>
                        </Viewbox>
                    </Button>
                    <Button Width="34" Height="30" Margin="0,0,2,0" Padding="1"
                            Background="Transparent" BorderThickness="0"
                            ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Container_Tooltip_CollapseExpand]}"
                            Command="{Binding ToggleCollapseCommand}">
                        <Viewbox Stretch="Uniform"
                                 Width="{Binding HeaderIconSize}"
                                 Height="{Binding HeaderIconSize}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                            <Grid Width="9" Height="9">
                                <Path x:Name="ChevronPath"
                                      Data="M0,1 L4.5,8 L9,1"
                                      Stroke="White" StrokeThickness="1.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </Path.RenderTransform>
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVisuallyCollapsed}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                                                 To="180" Duration="0:0:0.3"
                                                                                 DecelerationRatio="0.2" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                                                 To="0" Duration="0:0:0.3"
                                                                                 DecelerationRatio="0.2" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Content Area -->
            <Grid Grid.Row="1" AllowDrop="True">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsVisuallyCollapsed}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <ScrollViewer x:Name="ContentScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="6">
                    <Grid Background="Transparent" MouseDown="ContainerBody_MouseDown">
                    <!-- Icons view -->
                    <ItemsControl ItemsSource="{Binding Source={StaticResource ShortcutsView}}"
                                  x:Name="ShortcutsControl"
                                  dd:DragDrop.IsDragSource="True"
                                  dd:DragDrop.IsDropTarget="True"
                                  dd:DragDrop.DropHandler="{StaticResource ReorderHandler}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDetailsView}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="4"
                                        CornerRadius="6"
                                        MouseDown="Shortcut_OnMouseDown"
                                        Padding="4,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#25FFFFFF" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel VerticalAlignment="Top"
                                                HorizontalAlignment="Center"
                                                Cursor="Hand">
                                        <Grid Width="{Binding Data.ShortcutIconSize, Source={StaticResource VmProxy}}"
                                              Height="{Binding Data.ShortcutIconSize, Source={StaticResource VmProxy}}"
                                              Margin="4,2,4,4">
                                            <Image Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Source" Value="{Binding IconPath, Converter={StaticResource IconConverter}}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding (local:ContainerVisuals.ShowShortcutArrow), RelativeSource={RelativeSource Self}}" Value="False">
                                                                <Setter Property="Source" Value="{Binding IconPath, Converter={StaticResource IconNoArrowConverter}}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Grid>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   FontFamily="Segoe UI"
                                                   FontSize="10"
                                                   HorizontalAlignment="Center"
                                                   Margin="2,0,2,2"
                                                   MaxWidth="{Binding Data.ShortcutIconSize, Source={StaticResource VmProxy}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextWrapping" Value="NoWrap" />
                                                    <Setter Property="MaxHeight" Value="16" />
                                                    <Setter Property="Foreground">
                                                        <Setter.Value>
                                                            <SolidColorBrush Color="{Binding DataContext.LabelsColor, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <!-- Global Theme Active -->
                                                        <DataTrigger Binding="{Binding DataContext.IsThemeActive, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource ContainerLabelsForeground}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DataContext.TwoLineShortcuts, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
                                                            <Setter Property="TextWrapping" Value="Wrap" />
                                                            <Setter Property="MaxHeight" Value="30" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                        <!-- Details view -->
                        <ItemsControl ItemsSource="{Binding Source={StaticResource ShortcutsView}}"
                                      Visibility="{Binding IsDetailsView, Converter={StaticResource BoolToVisibilityConverter}}"
                                      dd:DragDrop.IsDragSource="True"
                                      dd:DragDrop.IsDropTarget="True"
                                      dd:DragDrop.DropHandler="{StaticResource ReorderHandler}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Foreground">
                                        <Setter.Value>
                                            <SolidColorBrush Color="{Binding LabelsColor}" />
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <!-- Global Theme Active -->
                                        <DataTrigger Binding="{Binding IsThemeActive}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource ContainerLabelsForeground}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="4,3" MouseDown="Shortcut_OnMouseDown" Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#30FFFFFF" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid Height="32">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="1.5*" />
                                                <ColumnDefinition Width="1.5*" />
                                            </Grid.ColumnDefinitions>
                                            <Image Width="20" Height="20"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   VerticalAlignment="Center">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Source" Value="{Binding IconPath, Converter={StaticResource IconConverter}}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding (local:ContainerVisuals.ShowShortcutArrow), RelativeSource={RelativeSource Self}}" Value="False">
                                                                <Setter Property="Source" Value="{Binding IconPath, Converter={StaticResource IconNoArrowConverter}}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DisplayName}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="8,0,4,0"
                                                       FontSize="12" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding DisplayType}"
                                                       VerticalAlignment="Center"
                                                       Foreground="#AAA"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding TargetPath}"
                                                       VerticalAlignment="Center"
                                                       Foreground="#777"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>

                <!-- Lock overlay for Private Box (on top of ScrollViewer) -->
                <Border Background="#CC000000"
                        Visibility="{Binding IsPasswordLocked, Converter={StaticResource BoolToVisibilityConverter}}"
                        Panel.ZIndex="10">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🔒" FontSize="48" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Container_LockOverlay_Locked]}"
                                   Foreground="#AAA" FontSize="13" Margin="0,8,0,8"
                                   HorizontalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <PasswordBox x:Name="UnlockPasswordBox"
                                         Width="140"
                                         Background="#333" BorderBrush="#555"
                                         Foreground="#EEE" Padding="6,3" FontSize="12"
                                         KeyDown="UnlockPassword_KeyDown" />
                            <Button Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Container_LockOverlay_Unlock]}"
                                    Background="#2A4A2A" BorderBrush="#4A6A4A" BorderThickness="1"
                                    Foreground="#8D8" Padding="8,4" FontSize="11"
                                    Margin="8,0,0,0" Cursor="Hand"
                                    Click="UnlockButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="UnlockErrorText"
                                   Foreground="#FF6666" FontSize="11"
                                   HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Resize handles -->
            <Rectangle x:Name="ResizeLeft" Width="4" HorizontalAlignment="Left"
                       Cursor="SizeWE" MouseMove="Resize_MouseMove" MouseDown="Resize_MouseDown" MouseUp="Resize_MouseUp" />
            <Rectangle x:Name="ResizeRight" Width="4" HorizontalAlignment="Right"
                       Cursor="SizeWE" MouseMove="Resize_MouseMove" MouseDown="Resize_MouseDown" MouseUp="Resize_MouseUp" />
            <Rectangle x:Name="ResizeTop" Height="4" VerticalAlignment="Top"
                       Cursor="SizeNS" MouseMove="Resize_MouseMove" MouseDown="Resize_MouseDown" MouseUp="Resize_MouseUp" />
            <Rectangle x:Name="ResizeBottom" Height="4" VerticalAlignment="Bottom"
                       Cursor="SizeNS" MouseMove="Resize_MouseMove" MouseDown="Resize_MouseDown" MouseUp="Resize_MouseUp" />
            <Rectangle x:Name="ResizeTopLeft" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top"
                       Cursor="SizeNWSE" MouseMove="Resize_MouseMove" MouseDown="Resize_MouseDown" MouseUp="Resize_MouseUp" />
            <Rectangle x:Name="ResizeTopRight" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top"
                       Cursor="SizeNESW" MouseMove="Resize_MouseMove" MouseDown="Resize_MouseDown" MouseUp="Resize_MouseUp" />
            <Rectangle x:Name="ResizeBottomLeft" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                       Cursor="SizeNESW" MouseMove="Resize_MouseMove" MouseDown="Resize_MouseDown" MouseUp="Resize_MouseUp" />
            <Rectangle x:Name="ResizeBottomRight" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Cursor="SizeNWSE" MouseMove="Resize_MouseMove" MouseDown="Resize_MouseDown" MouseUp="Resize_MouseUp" />
        </Grid>
    </Border>
</Grid>
</Window>
