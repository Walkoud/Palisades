                        </Button>
                                    </Grid>
                                </Border>

                <!-- Center Content -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="20,16">
                    <StackPanel>

                    <!-- ===== DASHBOARD PANEL ===== -->
                    <Grid x:Name="DashboardPanel">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="340" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Side: Containers and Active Widgets lists -->
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Sidebar_Dashboard]}" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource GuiTextForegroundBrush}" Margin="0,0,0,12"/>
                                        <ComboBox Width="180" HorizontalAlignment="Left" Height="30"
                                                  ItemsSource="{Binding ThemeNames}"
                                                  SelectedItem="{Binding SelectedThemeName}"
                                                  Background="{DynamicResource GuiBackgroundCardBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" Foreground="{DynamicResource GuiAccentBrush}" Padding="10,0" />
                                    </StackPanel>

                                    <!-- Premium New + Button -->
                                    <Button Grid.Column="1" VerticalAlignment="Bottom" Height="30" Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_NewButton]}" Click="NewButton_Click"
                                            Background="#3B82F6" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Padding="15,0">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="6" />
                                            </Style>
                                        </Button.Resources>
                                        <Button.ContextMenu>
                                            <ContextMenu Background="#1E1E1E" Foreground="White" BorderBrush="#333" BorderThickness="1">
                                                <ContextMenu.Resources>
                                                    <Style TargetType="MenuItem">
                                                        <Setter Property="Foreground" Value="White" />
                                                    </Style>
                                                </ContextMenu.Resources>
                                                <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_StandardContainer]}" Command="{Binding CreateNormalContainerCommand}" />
                                                <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_SvgContainer]}" Command="{Binding CreateSvgContainerCommand}" />
                                                <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_FolderPortal]}" Command="{Binding CreateFolderPortalCommand}" />
                                                <Separator Background="#333" />
                                                <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_PostItNote]}" Command="{Binding SpawnPostItCommand}" />
                                                <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_ClockGadget]}" Command="{Binding SpawnClockCommand}" />
                                                <MenuItem Header="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_SystemMonitor]}" Command="{Binding SpawnSysMonCommand}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </Grid>

                                <!-- Shortcut Containers Header -->
                                <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_ActiveContainers]}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource GuiAccentBrush}" Margin="10,0,0,10" />

                                <ItemsControl ItemsSource="{Binding Containers}" Margin="0,0,0,24">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" VerticalAlignment="Top"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="1" CornerRadius="12" Margin="10" MinHeight="220" VerticalAlignment="Top" Padding="14" MouseLeftButtonDown="ContainerCard_Click" Cursor="Hand" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                                <Border.BorderBrush>
                                                    <SolidColorBrush Color="{Binding HeaderColor}" Opacity="0.5" />
                                                </Border.BorderBrush>
                                                <Border.Background>
                                                    <Binding Path="PreviewBackgroundBrush" />
                                                </Border.Background>
                                                <Border.Effect>
                                                    <DropShadowEffect Color="{Binding HeaderColor}" BlurRadius="16" ShadowDepth="0" Opacity="0.25"/>
                                                </Border.Effect>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource GuiTextForegroundBrush}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Shortcuts.Count}" Foreground="#526475" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="2" Content="✕" Foreground="#526475" FontSize="10" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" Command="{Binding DeleteCommand}"/>
                                                    </Grid>
                                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Shortcuts}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="6,4">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>
                                                                    <Border x:Name="IconBorder" Grid.Row="0" Width="44" Height="44" Background="#0C1116" BorderBrush="#1C2630" BorderThickness="1" CornerRadius="8" Padding="6">
                                                                        <Grid Width="32" Height="32">
                                                                            <!-- SVG Content -->
                                                                            <Image Source="{Binding SvgContent, Converter={StaticResource SvgToImageConverter}, ConverterParameter='#FFFFFF'}"
                                                                                   Stretch="Uniform"
                                                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                                                                <Image.Style>
                                                                                    <Style TargetType="Image">
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding SvgContent}" Value="{x:Null}">
                                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding SvgContent}" Value="">
                                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Image.Style>
                                                                            </Image>
                                                                            <!-- Shell Icon (fallback when no SVG) -->
                                                                            <Image Source="{Binding TargetPath, Converter={StaticResource IconConverter}}"
                                                                                   Stretch="Uniform" Width="32" Height="32">
                                                                                <Image.Style>
                                                                                    <Style TargetType="Image">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                        <Style.Triggers>
                                                                                            <!-- Keep collapsed if SvgContent is null and TargetPath is empty/null -->
                                                                                            <MultiDataTrigger>
                                                                                                <MultiDataTrigger.Conditions>
                                                                                                    <Condition Binding="{Binding SvgContent}" Value="{x:Null}" />
                                                                                                    <Condition Binding="{Binding TargetPath}" Value="" />
                                                                                                </MultiDataTrigger.Conditions>
                                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                                            </MultiDataTrigger>
                                                                                            <!-- Show icon only when SvgContent is null/empty AND TargetPath has a value -->
                                                                                            <MultiDataTrigger>
                                                                                                <MultiDataTrigger.Conditions>
                                                                                                    <Condition Binding="{Binding SvgContent}" Value="{x:Null}" />
                                                                                                    <Condition Binding="{Binding TargetPath, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" Value="Collapsed" />
                                                                                                </MultiDataTrigger.Conditions>
                                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                            </MultiDataTrigger>
                                                                                            <MultiDataTrigger>
                                                                                                <MultiDataTrigger.Conditions>
                                                                                                    <Condition Binding="{Binding SvgContent}" Value="" />
                                                                                                    <Condition Binding="{Binding TargetPath, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" Value="Collapsed" />
                                                                                                </MultiDataTrigger.Conditions>
                                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                            </MultiDataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Image.Style>
                                                                            </Image>
                                                                        </Grid>
                                                                    </Border>
                                                                    <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="10" Foreground="{DynamicResource GuiTextForegroundBrush}" TextAlignment="Center" Width="60" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Active Desktop Widgets List -->
                                <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_ActiveWidgets]}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource GuiAccentBrush}" Margin="10,0,0,10" />
                                
                                <ListBox ItemsSource="{Binding ActiveWidgets}" SelectedItem="{Binding SelectedWidget}" 
                                         Background="{DynamicResource GuiBackgroundCardBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" BorderThickness="1" Margin="10,0,10,20" Padding="4" MaxHeight="250"
                                         PreviewMouseDown="ActiveWidgetsListBox_PreviewMouseDown">
                                    <ListBox.Resources>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="2"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </ListBox.Resources>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1C242E" BorderBrush="#2A3542" BorderThickness="1" CornerRadius="6" Padding="12,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource GuiTextForegroundBrush}" />
                                                        <TextBlock Text="{Binding GadgetType, StringFormat='{}{0}'}" FontSize="10" Foreground="#526475" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    
                                                    <TextBlock Grid.Column="1" Text="{Binding X, StringFormat='{}{0:0},'}" FontSize="11" Foreground="#526475" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Y, StringFormat='{}{0:0}'}" FontSize="11" Foreground="#526475" VerticalAlignment="Center" Margin="50,0,12,0" />

                                                    <Button Grid.Column="2" Content="✕" Foreground="#FF5F56" FontSize="11" FontWeight="Bold"
                                                            Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center" Padding="4"
                                                            Command="{Binding DataContext.DeleteGadgetCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Right Side: Customize Panel (glassmorphic settings details card) -->
                        <Border Grid.Column="1" Background="{DynamicResource GuiBackgroundCardBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="16,0,0,0" VerticalAlignment="Stretch">
                            <Grid>
                                <!-- Placeholder when nothing selected -->
                                <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_CustomizeWidgetPlaceholder]}" Foreground="#526475" FontSize="12" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="16"
                                           Visibility="{Binding IsWidgetSelected, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />

                                <!-- Selected Widget Customization Settings -->
                                <ScrollViewer Visibility="{Binding IsWidgetSelected, Converter={StaticResource BoolToVisibility}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_WidgetCustomization]}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource GuiAccentBrush}" Margin="0,0,0,16" />

                                        <!-- BASIC SETTINGS SECTION -->
                                        <Border BorderBrush="{DynamicResource GuiBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,16">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_BasicSettings]}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource GuiTextForegroundBrush}" Margin="0,0,0,12" />

                                                <!-- Widget Title -->
                                                <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_WidgetTitle]}" Foreground="#526475" FontSize="10" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding SelectedWidget.Title, UpdateSourceTrigger=PropertyChanged}" Background="#1F2731" BorderBrush="#2D3A4B" Foreground="White" Height="28" Padding="6,2" Margin="0,0,0,12" BorderThickness="1" />

                                                <!-- Hide Header Checkbox -->
                                                <CheckBox Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_HideHeaderBar]}" IsChecked="{Binding SelectedWidget.HideHeader, Mode=TwoWay}" Foreground="{DynamicResource GuiTextForegroundBrush}" FontSize="11" Margin="0,0,0,12" />

                                                <!-- Clock specific Basic Settings -->
                                                <StackPanel Visibility="{Binding SelectedWidgetIsClock, Converter={StaticResource BoolToVisibility}}">
                                                    <CheckBox Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_ShowSeconds]}" IsChecked="{Binding ClockShowSeconds, Mode=TwoWay}" Foreground="{DynamicResource GuiTextForegroundBrush}" FontSize="11" Margin="0,0,0,8" />
                                                    <CheckBox Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_24HourFormat]}" IsChecked="{Binding ClockIs24Hour, Mode=TwoWay}" Foreground="{DynamicResource GuiTextForegroundBrush}" FontSize="11" Margin="0,0,0,12" />

                                                    <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_ClockTextColor]}" Foreground="#526475" FontSize="10" Margin="0,0,0,4" />
                                                    <ComboBox SelectedValue="{Binding ClockColor, Mode=TwoWay}" SelectedValuePath="Tag" Background="#1F2731" BorderBrush="#2D3A4B" Foreground="{DynamicResource GuiAccentBrush}" Height="28" Margin="0,0,0,12">
                                                        <ComboBoxItem Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_ClockColor_IceBlue]}" Tag="#7DD3FC" />
                                                        <ComboBoxItem Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_ClockColor_White]}" Tag="#FFFFFF" />
                                                        <ComboBoxItem Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_ClockColor_MatrixGreen]}" Tag="#4AF626" />
                                                        <ComboBoxItem Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_ClockColor_AmberOrange]}" Tag="#FFB000" />
                                                        <ComboBoxItem Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_ClockColor_CyberRed]}" Tag="#FF3E3E" />
                                                    </ComboBox>

                                                    <TextBlock Text="{Binding ClockFontSize, StringFormat='Font Size ({0:0}pt)'}" Foreground="#526475" FontSize="10" Margin="0,0,0,4" />
                                                    <Slider Minimum="16" Maximum="72" Value="{Binding ClockFontSize, Mode=TwoWay}" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,12" />
                                                </StackPanel>

                                                <!-- System Monitor specific Basic Settings -->
                                                <StackPanel Visibility="{Binding SelectedWidgetIsSystemMonitor, Converter={StaticResource BoolToVisibility}}">
                                                    <CheckBox Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_ShowCpuStats]}" IsChecked="{Binding SysMonShowCpu, Mode=TwoWay}" Foreground="{DynamicResource GuiTextForegroundBrush}" FontSize="11" Margin="0,0,0,8" />
                                                    <CheckBox Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_ShowMemoryStats]}" IsChecked="{Binding SysMonShowRam, Mode=TwoWay}" Foreground="{DynamicResource GuiTextForegroundBrush}" FontSize="11" Margin="0,0,0,12" />

                                                    <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_RefreshInterval]}" Foreground="#526475" FontSize="10" Margin="0,0,0,4" />
                                                    <ComboBox SelectedValue="{Binding SysMonInterval, Mode=TwoWay}" SelectedValuePath="Tag" Background="#1F2731" BorderBrush="#2D3A4B" Foreground="{DynamicResource GuiAccentBrush}" Height="28" Margin="0,0,0,12">
                                                        <ComboBoxItem Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Interval_Fast]}" Tag="0.5" />
                                                        <ComboBoxItem Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Interval_Normal]}" Tag="1.0" />
                                                        <ComboBoxItem Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Interval_Medium]}" Tag="1.5" />
                                                        <ComboBoxItem Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Interval_Slow]}" Tag="2.0" />
                                                        <ComboBoxItem Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Interval_VerySlow]}" Tag="5.0" />
                                                    </ComboBox>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- VISUAL STYLE SETTINGS SECTION -->
                                        <Border BorderBrush="{DynamicResource GuiBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,16" Margin="0,0,0,16">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_StyleThemeCustomization]}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource GuiTextForegroundBrush}" Margin="0,0,0,12" />

                                                <!-- Background Color & Opacity -->
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_BgColor]}" Foreground="#526475" FontSize="10" Margin="0,0,0,4" />
                                                        <ComboBox SelectedValue="{Binding SelectedWidget.BgColor, Mode=TwoWay}" SelectedValuePath="Tag" Background="#1F2731" BorderBrush="#2D3A4B" Foreground="White" Height="28">
                                                            <ComboBoxItem Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Color_DeepBlack]}" Tag="#000000" />
                                                            <ComboBoxItem Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Color_GlacierDark]}" Tag="#0B0F19" />
                                                            <ComboBoxItem Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Color_SteelBlue]}" Tag="#1E3A5F" />
                                                            <ComboBoxItem Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Color_TealForest]}" Tag="#1E4A5F" />
                                                            <ComboBoxItem Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Color_Transparent]}" Tag="#00000000" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                        <TextBlock Text="{Binding SelectedWidget.BgOpacity, StringFormat='Bg Opacity ({0:0%})'}" Foreground="#526475" FontSize="10" Margin="0,0,0,4" />
                                                        <Slider Minimum="0.0" Maximum="1.0" Value="{Binding SelectedWidget.BgOpacity, Mode=TwoWay}" SmallChange="0.05" LargeChange="0.1" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Border Color & Thickness -->
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_BorderColor]}" Foreground="#526475" FontSize="10" Margin="0,0,0,4" />
                                                        <ComboBox SelectedValue="{Binding SelectedWidget.BorderColor, Mode=TwoWay}" SelectedValuePath="Tag" Background="#1F2731" BorderBrush="#2D3A4B" Foreground="White" Height="28">
                                                            <ComboBoxItem Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Color_GlassWhite]}" Tag="#35FFFFFF" />
                                                            <ComboBoxItem Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Color_GlacierNeon]}" Tag="#507DD3FC" />
                                                            <ComboBoxItem Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Color_EmeraldGlow]}" Tag="#504AF626" />
                                                            <ComboBoxItem Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Color_AmberGlow]}" Tag="#50FFB000" />
                                                            <ComboBoxItem Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Color_NoBorder]}" Tag="#00000000" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                        <TextBlock Text="{Binding SelectedWidget.BorderThicknessValue, StringFormat='Border Width ({0:0.0}px)'}" Foreground="#526475" FontSize="10" Margin="0,0,0,4" />
                                                        <Slider Minimum="0.0" Maximum="6.0" Value="{Binding SelectedWidget.BorderThicknessValue, Mode=TwoWay}" SmallChange="0.5" LargeChange="1.0" TickFrequency="0.5" IsSnapToTickEnabled="True" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Corner Radius -->
                                                <TextBlock Text="{Binding SelectedWidget.CornerRadiusValue, StringFormat='Corner Radius ({0:0}px)'}" Foreground="#526475" FontSize="10" Margin="0,0,0,4" />
                                                <Slider Minimum="0" Maximum="24" Value="{Binding SelectedWidget.CornerRadiusValue, Mode=TwoWay}" SmallChange="1" LargeChange="4" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,10" />

                                                <!-- Header Settings -->
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_HeaderColor]}" Foreground="#526475" FontSize="10" Margin="0,0,0,4" />
                                                        <ComboBox SelectedValue="{Binding SelectedWidget.HeaderBgColor, Mode=TwoWay}" SelectedValuePath="Tag" Background="#1F2731" BorderBrush="#2D3A4B" Foreground="White" Height="28">
                                                            <ComboBoxItem Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_HeaderColor_DarkIce]}" Tag="#25101520" />
                                                            <ComboBoxItem Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_HeaderColor_SteelHeader]}" Tag="#251E3A5F" />
                                                            <ComboBoxItem Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Color_DeepBlack]}" Tag="#80000000" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_HeaderBorder]}" Foreground="#526475" FontSize="10" Margin="0,0,0,4" />
                                                        <ComboBox SelectedValue="{Binding SelectedWidget.HeaderBorderColor, Mode=TwoWay}" SelectedValuePath="Tag" Background="#1F2731" BorderBrush="#2D3A4B" Foreground="White" Height="28">
                                                            <ComboBoxItem Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_HeaderBorder_SubtleWhite]}" Tag="#20FFFFFF" />
                                                            <ComboBoxItem Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_HeaderBorder_Glacier]}" Tag="#207DD3FC" />
                                                            <ComboBoxItem Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_HeaderBorder_None]}" Tag="#00000000" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Title Style settings -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_TitleTextColor]}" Foreground="#526475" FontSize="10" Margin="0,0,0,4" />
                                                        <ComboBox SelectedValue="{Binding SelectedWidget.TitleColor, Mode=TwoWay}" SelectedValuePath="Tag" Background="#1F2731" BorderBrush="#2D3A4B" Foreground="White" Height="28">
                                                            <ComboBoxItem Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Color_GlacierBlue]}" Tag="#7DD3FC" />
                                                            <ComboBoxItem Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Color_CleanWhite]}" Tag="#FFFFFF" />
                                                            <ComboBoxItem Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_ClockColor_MatrixGreen]}" Tag="#4AF626" />
                                                            <ComboBoxItem Content="Rose" Tag="#F43F5E" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                        <TextBlock Text="{Binding SelectedWidget.TitleFontSize, StringFormat='Title Font Size ({0:0}pt)'}" Foreground="#526475" FontSize="10" Margin="0,0,0,4" />
                                                        <Slider Minimum="8" Maximum="24" Value="{Binding SelectedWidget.TitleFontSize, Mode=TwoWay}" SmallChange="1" LargeChange="2" TickFrequency="1" IsSnapToTickEnabled="True" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- ADVANCED LAYOUT SETTINGS SECTION -->
                                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_AdvancedSettings]}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource GuiTextForegroundBrush}" Margin="0,0,0,12" />

                                        <!-- Width & Height sliders -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,6,0">
                                                <TextBlock Text="{Binding SelectedWidget.Width, StringFormat='Width ({0:0}px)'}" Foreground="#526475" FontSize="10" Margin="0,0,0,4" />
                                                <Slider Minimum="100" Maximum="800" Value="{Binding SelectedWidget.Width, Mode=TwoWay}" SmallChange="5" LargeChange="20" TickFrequency="5" IsSnapToTickEnabled="True" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding SelectedWidget.Height, StringFormat='Height ({0:0}px)'}" Foreground="#526475" FontSize="10" Margin="0,0,0,4" />
                                                <Slider Minimum="50" Maximum="600" Value="{Binding SelectedWidget.Height, Mode=TwoWay}" SmallChange="5" LargeChange="20" TickFrequency="5" IsSnapToTickEnabled="True" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Position X & Y sliders -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,6,0">
                                                <TextBlock Text="{Binding SelectedWidget.X, StringFormat='Position X ({0:0}px)'}" Foreground="#526475" FontSize="10" Margin="0,0,0,4" />
                                                <Slider Minimum="0" Maximum="2560" Value="{Binding SelectedWidget.X, Mode=TwoWay}" SmallChange="5" LargeChange="50" TickFrequency="5" IsSnapToTickEnabled="True" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding SelectedWidget.Y, StringFormat='Position Y ({0:0}px)'}" Foreground="#526475" FontSize="10" Margin="0,0,0,4" />
                                                <Slider Minimum="0" Maximum="1600" Value="{Binding SelectedWidget.Y, Mode=TwoWay}" SmallChange="5" LargeChange="50" TickFrequency="5" IsSnapToTickEnabled="True" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Opacity slider -->
                                        <TextBlock Text="{Binding SelectedWidget.Opacity, StringFormat='Opacity ({0:0%})'}" Foreground="#526475" FontSize="10" Margin="0,0,0,4" />
                                        <Slider Minimum="0.1" Maximum="1.0" Value="{Binding SelectedWidget.Opacity, Mode=TwoWay}" SmallChange="0.05" LargeChange="0.1" Margin="0,0,0,12" />

                                        <!-- Margins sliders -->
                                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_WidgetMargins]}" Foreground="{DynamicResource GuiTextForegroundBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,6,0">
                                                <TextBlock Text="{Binding SelectedWidget.MarginLeft, StringFormat='Margin Left ({0:0}px)'}" Foreground="#526475" FontSize="10" Margin="0,0,0,4" />
                                                <Slider Minimum="0" Maximum="100" Value="{Binding SelectedWidget.MarginLeft, Mode=TwoWay}" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding SelectedWidget.MarginTop, StringFormat='Margin Top ({0:0}px)'}" Foreground="#526475" FontSize="10" Margin="0,0,0,4" />
                                                <Slider Minimum="0" Maximum="100" Value="{Binding SelectedWidget.MarginTop, Mode=TwoWay}" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,6,0">
                                                <TextBlock Text="{Binding SelectedWidget.MarginRight, StringFormat='Margin Right ({0:0}px)'}" Foreground="#526475" FontSize="10" Margin="0,0,0,4" />
                                                <Slider Minimum="0" Maximum="100" Value="{Binding SelectedWidget.MarginRight, Mode=TwoWay}" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding SelectedWidget.MarginBottom, StringFormat='Margin Bottom ({0:0}px)'}" Foreground="#526475" FontSize="10" Margin="0,0,0,4" />
                                                <Slider Minimum="0" Maximum="100" Value="{Binding SelectedWidget.MarginBottom, Mode=TwoWay}" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Paddings sliders -->
                                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_WidgetPaddings]}" Foreground="{DynamicResource GuiTextForegroundBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,6,0">
                                                <TextBlock Text="{Binding SelectedWidget.PaddingLeft, StringFormat='Padding Left ({0:0}px)'}" Foreground="#526475" FontSize="10" Margin="0,0,0,4" />
                                                <Slider Minimum="0" Maximum="100" Value="{Binding SelectedWidget.PaddingLeft, Mode=TwoWay}" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding SelectedWidget.PaddingTop, StringFormat='Padding Top ({0:0}px)'}" Foreground="#526475" FontSize="10" Margin="0,0,0,4" />
                                                <Slider Minimum="0" Maximum="100" Value="{Binding SelectedWidget.PaddingTop, Mode=TwoWay}" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,6,0">
                                                <TextBlock Text="{Binding SelectedWidget.PaddingRight, StringFormat='Padding Right ({0:0}px)'}" Foreground="#526475" FontSize="10" Margin="0,0,0,4" />
                                                <Slider Minimum="0" Maximum="100" Value="{Binding SelectedWidget.PaddingRight, Mode=TwoWay}" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding SelectedWidget.PaddingBottom, StringFormat='Padding Bottom ({0:0}px)'}" Foreground="#526475" FontSize="10" Margin="0,0,0,4" />
                                                <Slider Minimum="0" Maximum="100" Value="{Binding SelectedWidget.PaddingBottom, Mode=TwoWay}" SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <StackPanel x:Name="ContainersPanel" Visibility="Collapsed">
                        <Border Background="{DynamicResource GuiBackgroundCardBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_ContainerProperties]}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource GuiAccentBrush}" Margin="0,0,0,16" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_SelectContainer]}" Foreground="{DynamicResource GuiTextForegroundBrush}" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Containers}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedContainer}" Background="{DynamicResource GuiBackgroundMainBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" FontSize="12" />
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_ButtonName]}" Foreground="{DynamicResource GuiTextForegroundBrush}" VerticalAlignment="Center" FontSize="13" />
                                    <TextBox Grid.Column="1" Text="{Binding SelectedContainer.Name, UpdateSourceTrigger=PropertyChanged}" BorderBrush="{DynamicResource GuiBorderBrush}" Padding="8,5" FontSize="13" />
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_ResetToDefaults]}" Command="{Binding ApplyDefaultsToContainerCommand}" Padding="12,6" Background="{DynamicResource GuiBackgroundCardBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" Foreground="{DynamicResource GuiAccentBrush}" Cursor="Hand" Margin="0,0,8,0"/>
                                    <Button Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_SaveDefaults]}" Command="{Binding SelectedContainer.SetAsDefaultCommand}" Padding="12,6" Background="{DynamicResource GuiBackgroundCardBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" Cursor="Hand"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- SVG Buttons Config Panel -->
                        <Border Background="{DynamicResource GuiBackgroundCardBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,12"
                                Visibility="{Binding SelectedContainer.IsSvgButtonContainer, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_ConfigureSvgButtons]}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource GuiAccentBrush}" Margin="0,0,0,14" />

                                <!-- SVG Size -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="45" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_SvgSize]}" Foreground="{DynamicResource GuiTextForegroundBrush}" VerticalAlignment="Center" FontSize="12" />
                                    <Slider Grid.Column="1" Style="{StaticResource ArcticSliderStyle}" Minimum="16" Maximum="96" Value="{Binding SelectedContainer.SvgImageSize, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="2" Text="{Binding SelectedContainer.SvgImageSize}" Foreground="{DynamicResource GuiTextForegroundBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" />
                                </Grid>

                                <!-- Button Size -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="45" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_ButtonSize]}" Foreground="{DynamicResource GuiTextForegroundBrush}" VerticalAlignment="Center" FontSize="12" />
                                    <Slider Grid.Column="1" Style="{StaticResource ArcticSliderStyle}" Minimum="24" Maximum="128" Value="{Binding SelectedContainer.SvgButtonSize, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="2" Text="{Binding SelectedContainer.SvgButtonSize}" Foreground="{DynamicResource GuiTextForegroundBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" />
                                </Grid>

                                <CheckBox IsChecked="{Binding SelectedContainer.SvgButtonShowBg, Mode=TwoWay}" FontSize="12" Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_ShowButtonBg]}" Style="{StaticResource ArcticToggleSwitchStyle}" />
                                <CheckBox IsChecked="{Binding SelectedContainer.HideAddSvgButton, Mode=TwoWay}" FontSize="12" Margin="0,6,0,14" Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_HideAddButton]}" Style="{StaticResource ArcticToggleSwitchStyle}" />

                                <!-- Container Title Settings (Merged from second panel) -->
                                <CheckBox Margin="0,6,0,0" IsChecked="{Binding SelectedContainer.ShowTitle}" FontSize="12" Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_ShowTitle]}" Style="{StaticResource ArcticToggleSwitchStyle}"/>
                                <Grid Margin="0,6,0,8" Visibility="{Binding SelectedContainer.ShowTitle, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Header_Font]}" Foreground="{DynamicResource GuiTextForegroundBrush}" VerticalAlignment="Center" FontSize="12" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Source={x:Static vm:ContainerViewModel.FontFamilies}}" SelectedItem="{Binding SelectedContainer.TitleFontFamily}" Background="{DynamicResource GuiBackgroundMainBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" FontSize="12" />
                                </Grid>
                                <Grid Margin="0,0,0,8" Visibility="{Binding SelectedContainer.ShowTitle, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="45" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_TitleFontSizeLabel]}" Foreground="{DynamicResource GuiTextForegroundBrush}" VerticalAlignment="Center" FontSize="12" />
                                    <Slider Grid.Column="1" Style="{StaticResource ArcticSliderStyle}" Minimum="9" Maximum="20" Value="{Binding SelectedContainer.TitleFontSize, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="2" Text="{Binding SelectedContainer.TitleFontSize, StringFormat={}{0:F0}}" Foreground="{DynamicResource GuiTextForegroundBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" />
                                </Grid>
                                <Grid Margin="0,0,0,8" Visibility="{Binding SelectedContainer.ShowTitle, Converter={StaticResource BoolToVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Header_Alignment]}" Foreground="{DynamicResource GuiTextForegroundBrush}" VerticalAlignment="Center" FontSize="12" />
                                    <ComboBox Grid.Column="1" SelectedValue="{Binding SelectedContainer.TitleAlignment}" SelectedValuePath="Content" Background="{DynamicResource GuiBackgroundMainBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" FontSize="12">
                                        <ComboBoxItem Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Align_Left]}" />
                                        <ComboBoxItem Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Align_Center]}" />
                                        <ComboBoxItem Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Align_Right]}" />
                                    </ComboBox>
                                </Grid>
                                <CheckBox Margin="0,4,0,14" IsChecked="{Binding SelectedContainer.TitleHoverEffect}" FontSize="12" Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Header_HoverEffect]}" Style="{StaticResource ArcticToggleSwitchStyle}" Visibility="{Binding SelectedContainer.ShowTitle, Converter={StaticResource BoolToVisibility}}"/>

                                <!-- Horizontal List of SVG Buttons (Live Preview) -->
                                <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_SelectButtonToEdit]}" Foreground="{DynamicResource GuiTextForegroundBrush}" FontSize="11" Margin="0,0,0,6" />
                                
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <ListBox x:Name="SvgButtonsListBox" 
                                             ItemsSource="{Binding SelectedContainer.Shortcuts}" 
                                             Background="{DynamicResource GuiBackgroundMainBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" BorderThickness="1"
                                             Height="70"
                                             SelectionChanged="SvgButtonsListBox_SelectionChanged"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="50" Height="50" CornerRadius="6" Background="#15FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" Padding="4" ToolTip="{Binding DisplayName}">
                                                    <Grid>
                                                        <!-- SVG Image -->
                                                        <Image Source="{Binding SvgContent, Converter={StaticResource SvgToImageConverter}, ConverterParameter='#FFFFFF'}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SvgContent}" Value="{x:Null}">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding SvgContent}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>
                                                        <!-- Image Path -->
                                                        <Image Source="{Binding IconPath, Converter={StaticResource FilePathToImage}}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <!-- Show only if SvgContent is null or empty -->
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding SvgContent}" Value="{x:Null}" />
                                                                                <Condition Binding="{Binding IconPath, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding SvgContent}" Value="" />
                                                                                <Condition Binding="{Binding IconPath, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" Value="Collapsed" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>
                                                        <!-- Fallback Text -->
                                                        <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="8" TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding SvgContent}" Value="{x:Null}" />
                                                                                <Condition Binding="{Binding IconPath}" Value="" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                        <MultiDataTrigger>
                                                                            <MultiDataTrigger.Conditions>
                                                                                <Condition Binding="{Binding SvgContent}" Value="" />
                                                                                <Condition Binding="{Binding IconPath}" Value="" />
                                                                            </MultiDataTrigger.Conditions>
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </MultiDataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    
                                    <!-- Add New Button -->
                                    <Button Grid.Column="1" Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_AddButton]}" Click="AddSvgButtonDashboard_Click" Margin="8,0,0,0" Width="90" Height="70" Background="{DynamicResource GuiBackgroundCardBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" Foreground="{DynamicResource GuiAccentBrush}" FontWeight="SemiBold" Cursor="Hand" />
                                </Grid>
                                
                                <!-- Edit Form for selected SVG Button -->
                                <StackPanel Visibility="{Binding SelectedItem, ElementName=SvgButtonsListBox, Converter={StaticResource NullToVisibility}}">
                                    <Border BorderBrush="{DynamicResource GuiBorderBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,12" Padding="0,8,0,0">
                                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_EditButtonProperties]}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource GuiAccentBrush}" Margin="0,0,0,10" />
                                    </Border>
                                    
                                    <!-- Button Name -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_ButtonName]}" Foreground="{DynamicResource GuiTextForegroundBrush}" VerticalAlignment="Center" FontSize="12" />
                                        <TextBox Grid.Column="1" Text="{Binding SelectedItem.Name, ElementName=SvgButtonsListBox, UpdateSourceTrigger=PropertyChanged}" TextChanged="SvgButtonProperty_Changed" BorderBrush="{DynamicResource GuiBorderBrush}" Padding="5,3" FontSize="12" />
                                    </Grid>
                                    
                                    <!-- Target Path or Web URL -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_TargetUrl]}" Foreground="{DynamicResource GuiTextForegroundBrush}" VerticalAlignment="Center" FontSize="12" />
                                        <TextBox Grid.Column="1" x:Name="DashboardTargetTextBox" TextChanged="SvgButtonTarget_Changed" BorderBrush="{DynamicResource GuiBorderBrush}" Padding="5,3" FontSize="12" />
                                        <!-- Browse File/Folder buttons -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                                            <Button Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_BrowseFile]}" Click="BrowseSvgButtonFile_Click" Padding="6,2" Height="24" Background="{DynamicResource GuiBackgroundCardBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" FontSize="11" Cursor="Hand" Margin="0,0,4,0"/>
                                            <Button Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_BrowseFolder]}" Click="BrowseSvgButtonFolder_Click" Padding="6,2" Height="24" Background="{DynamicResource GuiBackgroundCardBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" FontSize="11" Cursor="Hand"/>
                                        </StackPanel>
                                    </Grid>
                                    
                                    <!-- Arguments -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[SvgEdit_Arguments]}" Foreground="{DynamicResource GuiTextForegroundBrush}" VerticalAlignment="Center" FontSize="12" />
                                        <TextBox Grid.Column="1" Text="{Binding SelectedItem.Arguments, ElementName=SvgButtonsListBox, UpdateSourceTrigger=PropertyChanged}" TextChanged="SvgButtonProperty_Changed" BorderBrush="{DynamicResource GuiBorderBrush}" Padding="5,3" FontSize="12" />
                                    </Grid>
                                    
                                    <!-- Hotkey -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[SvgEdit_Hotkey]}" Foreground="{DynamicResource GuiTextForegroundBrush}" VerticalAlignment="Center" FontSize="12" />
                                        <TextBox Grid.Column="1" x:Name="DashboardHotkeyTextBox" PreviewKeyDown="DashboardHotkeyTextBox_PreviewKeyDown" IsReadOnly="True" BorderBrush="{DynamicResource GuiBorderBrush}" Padding="5,3" FontSize="12" ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[SvgEdit_HotkeyTooltip]}" />
                                    </Grid>
                                    
                                    <!-- Icon Selection -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_CustomIcon]}" Foreground="{DynamicResource GuiTextForegroundBrush}" VerticalAlignment="Center" FontSize="12" />
                                        
                                        <!-- Display Icon Type or Path -->
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedItem.IconPath}" Foreground="#526475" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis" Margin="4,0,8,0" />
                                        
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_ImportImageSvg]}" Click="ImportSvgButtonImage_Click" Padding="8,3" Height="26" Background="{DynamicResource GuiBackgroundCardBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" FontSize="11" Cursor="Hand" Margin="0,0,4,0"/>
                                            <Button Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_EditSvgXml]}" Click="EditSvgButtonXml_Click" Padding="8,3" Height="26" Background="{DynamicResource GuiBackgroundCardBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" FontSize="11" Cursor="Hand" Margin="0,0,4,0"/>
                                            <Button Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_DeleteButton]}" Click="DeleteSvgButton_Click" Padding="8,3" Height="26" Background="#991B1B" BorderBrush="#7F1D1D" Foreground="White" FontSize="11" Cursor="Hand" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource GuiBackgroundCardBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Colors]}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource GuiAccentBrush}" Margin="0,0,0,14" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
