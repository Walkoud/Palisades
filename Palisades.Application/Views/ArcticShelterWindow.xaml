                                    <TextBlock Grid.Column="2" Text="{Binding SelectedContainer.CornerRadius}" Foreground="{DynamicResource GuiTextForegroundBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" />
