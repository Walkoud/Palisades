                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_ThemePreset]}" Foreground="{DynamicResource GuiTextForegroundBrush}" VerticalAlignment="Center" FontSize="12" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ContainerThemeNames}" SelectedItem="{Binding SelectedContainer.ContainerThemeName}" Background="{DynamicResource GuiBackgroundMainBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" FontSize="12" />
