                            <Button x:Name="PluginsBtn" Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Sidebar_Plugins]}" CommandParameter="Plugins" Style="{StaticResource SidebarBtnStyle}" Click="Tab_Click">
                                <Button.Tag>
                                    <Viewbox Width="16" Height="16">
                                        <Path Data="M 12,2 A 3,3 0 0 0 9.17,4 H 6 A 2,2 0 0 0 4,6 V 9.17 A 3,3 0 0 0 6,12 A 3,3 0 0 0 4,14.83 V 18 A 2,2 0 0 0 6,20 H 9.17 A 3,3 0 0 0 12,18 A 3,3 0 0 0 14.83,20 H 18 A 2,2 0 0 0 20,18 V 14.83 A 3,3 0 0 0 18,12 A 3,3 0 0 0 20,9.17 V 6 A 2,2 0 0 0 18,4 H 14.83 A 3,3 0 0 0 12,2 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Viewbox>
                                </Button.Tag>
                            </Button>
                        </StackPanel>

                        <Button x:Name="AppBtn" Grid.Row="2" Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Sidebar_AppSettings]}" CommandParameter="App" Style="{StaticResource SidebarBtnStyle}" Margin="0,0,0,16" Click="Tab_Click">
                            <Button.Tag>
                                <Viewbox Width="16" Height="16">
                                    <Path Data="M 19.1,12.9 C 19.2,12.3 19.2,11.7 19.1,11.1 L 21.2,9.5 C 21.4,9.3 21.4,9.0 21.3,8.8 L 19.3,5.3 C 19.2,5.1 18.9,5.0 18.7,5.1 L 16.2,6.1 C 15.7,5.7 15.1,5.4 14.5,5.1 L 14.1,2.5 C 14.1,2.2 13.9,2.0 13.6,2.0 L 9.6,2.0 C 9.3,2.0 9.1,2.2 9.1,2.5 L 8.7,5.1 C 8.1,5.4 7.5,5.7 7.0,6.1 L 4.5,5.1 C 4.3,5.0 4.0,5.1 3.9,5.3 L 1.9,8.8 C 1.8,9.0 1.8,9.3 2.0,9.5 L 4.1,11.1 C 4.0,11.7 4.0,12.3 4.1,12.9 L 2.0,14.5 C 1.8,14.7 1.8,15.0 1.9,15.2 L 3.9,18.7 C 4.0,18.9 4.3,19.0 4.5,18.9 L 7.0,17.9 C 7.5,18.3 8.1,18.6 8.7,18.9 L 9.1,21.5 C 9.1,21.8 9.3,22.0 9.6,22.0 L 13.6,22.0 C 13.9,22.0 14.1,21.8 14.1,21.5 L 14.5,18.9 C 15.1,18.6 15.7,18.3 16.2,17.9 L 18.7,18.9 C 18.9,19.0 19.2,18.9 19.3,18.7 L 21.3,15.2 C 21.4,15.0 21.4,14.7 21.2,14.5 L 19.1,12.9 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
