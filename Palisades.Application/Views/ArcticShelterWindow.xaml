                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="45" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_BgOpacityLabel]}" Foreground="{DynamicResource GuiTextForegroundBrush}" VerticalAlignment="Center" FontSize="12" />
                                    <Slider Grid.Column="1" Style="{StaticResource ArcticSliderStyle}" Minimum="0" Maximum="100" Value="{Binding SelectedContainer.BodyOpacity, Mode=TwoWay}" />
