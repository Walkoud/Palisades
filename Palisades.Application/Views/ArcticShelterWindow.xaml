<Window x:Class="Palisades.Views.ArcticShelterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Palisades.Converters"
        xmlns:svc="clr-namespace:Palisades.Services"
        xmlns:vm="clr-namespace:Palisades.ViewModels"
        Title="Palisades Dashboard — Arctic Shelter"
        Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        MinWidth="900" MinHeight="550"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Ressources/ArcticShelterTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:PathToImageConverter x:Key="IconConverter" ShowArrow="False" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InvertBoolConverter x:Key="InvertBool" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:EqualsConverter x:Key="EqualsConverter" />
            <conv:IsInListConverter x:Key="IsInListConverter" />
            <conv:FilePathToImageConverter x:Key="FilePathToImage" />
            <conv:SvgToImageConverter x:Key="SvgToImageConverter" />

            <Style x:Key="ArcticSliderStyle" TargetType="Slider">
                <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="#7DD3FC" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" Name="RowIndex" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border x:Name="TrackBackground" Grid.Row="1" Height="6" CornerRadius="3" Background="#1A222B" BorderBrush="{DynamicResource GuiBorderBrush}" BorderThickness="1" Margin="5,0">
                                        <Canvas Margin="-1,-1">
                                            <Border x:Name="PART_SelectionRange" Height="6" CornerRadius="3" Background="#7DD3FC" Visibility="Collapsed" />
                                        </Canvas>
                                    </Border>
                                    <Track Grid.Row="1" Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="false">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="RepeatButton">
                                                        <Border Height="6" CornerRadius="3" Background="#7DD3FC" Margin="5,0,0,0"/>
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="false">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="RepeatButton">
                                                        <Border Height="6" CornerRadius="3" Background="#1E293B" Margin="0,0,5,0"/>
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Width="16" Height="16" Focusable="false">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Ellipse Width="14" Height="14" Fill="#7DD3FC">
                                                            <Ellipse.Effect>
                                                                <DropShadowEffect Color="#7DD3FC" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                                                            </Ellipse.Effect>
                                                        </Ellipse>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ArcticToggleSwitchStyle" TargetType="CheckBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="#E2F1FF"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid x:Name="templateRoot" Background="Transparent" SnapsToDevicePixels="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="switchBorder" Grid.Column="0" Width="36" Height="20" CornerRadius="10" Background="#1E293B" BorderBrush="{DynamicResource GuiBorderBrush}" BorderThickness="1" SnapsToDevicePixels="True" VerticalAlignment="Center">
                                    <Grid>
                                        <Ellipse x:Name="thumb" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0" Fill="#E2F1FF">
                                            <Ellipse.RenderTransform>
                                                <TranslateTransform X="0" Y="0"/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                    </Grid>
                                </Border>
                                <ContentPresenter Grid.Column="1" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="true">
                                    <Setter TargetName="switchBorder" Property="Background" Value="#7DD3FC"/>
                                    <Setter TargetName="thumb" Property="Fill" Value="#11161B"/>
                                    <Setter TargetName="thumb" Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform X="16" Y="0"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter TargetName="switchBorder" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#7DD3FC" BlurRadius="6" ShadowDepth="0" Opacity="0.5"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="true">
                                    <Setter TargetName="switchBorder" Property="BorderBrush" Value="#7DD3FC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SidebarBtnStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="#8A9CAE"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="Margin" Value="0,4,0,4"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderThickness="4,0,0,0" BorderBrush="Transparent" Padding="18,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" Content="{TemplateBinding Tag}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{TemplateBinding Content}" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Foreground="{TemplateBinding Foreground}"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#087DD3FC"/>
                                    <Setter Property="Foreground" Value="#E2F1FF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SidebarBtnActiveStyle" TargetType="Button">
                <Setter Property="Background" Value="#0F7DD3FC"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="#7DD3FC"/>
                <Setter Property="Height" Value="44"/>
                <Setter Property="Margin" Value="0,4,0,4"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderThickness="4,0,0,0" BorderBrush="#7DD3FC" Padding="18,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" Content="{TemplateBinding Tag}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{TemplateBinding Content}" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}"/>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <LinearGradientBrush x:Key="LogoGradient1" MappingMode="Absolute" StartPoint="461.784,1050.74" EndPoint="1052.71,985.527">
                <GradientStop Offset="0" Color="#1E9AC5"/>
                <GradientStop Offset="1" Color="#32D3C6"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="LogoGradient2" MappingMode="Absolute" StartPoint="395.058,459.143" EndPoint="801.245,413.11">
                <GradientStop Offset="0" Color="#1C95C5"/>
                <GradientStop Offset="1" Color="#2ABAC5"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="LogoGradient3" MappingMode="Absolute" StartPoint="968.02,887.521" EndPoint="965.6,779.51">
                <GradientStop Offset="0" Color="#0D6A82"/>
                <GradientStop Offset="1" Color="#117C86"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="LogoGradient4" MappingMode="Absolute" StartPoint="506.88,760.653" EndPoint="1035.15,751.311">
                <GradientStop Offset="0" Color="#1F9FC6"/>
                <GradientStop Offset="1" Color="#32D3C5"/>
            </LinearGradientBrush>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource GuiBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

