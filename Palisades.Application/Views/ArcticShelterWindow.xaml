                                        </Button.Style>
                                        <Viewbox Width="20" Height="20">
                                            <Path Fill="#E2F1FF" Data="M12,2A10,10 0 0,0 2,12C2,16.42 4.87,20.17 8.84,21.5C9.34,21.58 9.5,21.27 9.5,21C9.5,20.77 9.5,20.14 9.5,19.31C6.73,19.91 6.14,17.97 6.14,17.97C5.68,16.81 5.03,16.5 5.03,16.5C4.12,15.88 5.1,15.9 5.1,15.9C6.1,15.97 6.63,16.93 6.63,16.93C7.5,18.45 8.97,18 9.54,17.76C9.63,17.11 9.89,16.67 10.17,16.42C7.95,16.17 5.62,15.31 5.62,11.5C5.62,10.39 6,9.5 6.65,8.79C6.55,8.54 6.2,7.5 6.75,6.15C6.75,6.15 7.59,5.88 9.5,7.17C10.29,6.95 11.15,6.84 12,6.84C12.85,6.84 13.71,6.95 14.5,7.17C16.41,5.88 17.25,6.15 17.25,6.15C17.8,7.5 17.45,8.54 17.35,8.79C18,9.5 18.38,10.39 18.38,11.5C18.38,15.32 16.04,16.16 13.81,16.41C14.17,16.72 14.5,17.33 14.5,18.26C14.5,19.6 14.5,20.68 14.5,21C14.5,21.27 14.66,21.59 15.17,21.5C19.14,20.16 22,16.42 22,12A10,10 0 0,0 12,2Z" />
                                        </Viewbox>
                                    </Button>

                                    <!-- Buy Me A Coffee Link -->
                                    <Button Width="40" Height="40" Padding="0" Cursor="Hand" Click="BuyMeACoffeeLink_Click" Background="{DynamicResource GuiBackgroundCardBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" BorderThickness="1">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="border" Property="Background" Value="#2A241F"/>
                                                                    <Setter TargetName="border" Property="BorderBrush" Value="#F59E0B"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                        <Viewbox Width="20" Height="20">
                                            <Path Fill="#F59E0B" Data="M2 21h18v-2H2v2M20 3H4v10c0 2.21 1.79 4 4 4h6c2.21 0 4-1.79 4-4v-3h2c1.66 0 3-1.34 3-3V6c0-1.66-1.34-3-3-3m0 7h-2V5h2c.55 0 1 .45 1 1v3c0 .55-.45 1-1 1z" />
                                        </Viewbox>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Contributors Card -->
                        <Border Background="{DynamicResource GuiBackgroundCardBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Contributors" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource GuiAccentBrush}" Margin="0,0,0,12" />
                                <ItemsControl ItemsSource="{Binding Contributors}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel MaxWidth="500" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="80" Margin="0,0,8,8" Padding="6" Background="{DynamicResource GuiBackgroundMainBrush}" CornerRadius="6" BorderBrush="{DynamicResource GuiBorderBrush}" BorderThickness="1">
                                                <StackPanel>
                                                    <Border Width="48" Height="48" CornerRadius="24" BorderThickness="1" BorderBrush="{DynamicResource GuiBorderBrush}" HorizontalAlignment="Center">
                                                        <Image Source="{Binding AvatarUrl}" Width="48" Height="48" Stretch="UniformToFill">
                                                            <Image.Clip>
                                                                <EllipseGeometry RadiusX="24" RadiusY="24" Center="24,24" />
                                                            </Image.Clip>
                                                        </Image>
                                                    </Border>
                                                    <TextBlock Text="{Binding Login}" FontSize="10" Foreground="{DynamicResource GuiTextForegroundBrush}" TextAlignment="Center" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                    <!-- ===== SNAPSHOTS PANEL ===== -->
                    <StackPanel x:Name="SnapshotsPanel" Visibility="Collapsed">
                        <Border Background="{DynamicResource GuiBackgroundCardBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Sidebar_Snapshots]}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource GuiAccentBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_ClearAllSnapshots]}" Command="{Binding ClearAllSnapshotsCommand}" Padding="10,6" Background="#2C1A1A" BorderBrush="#3C2222" Foreground="#FCA5A5" Cursor="Hand" Margin="0,0,8,0"/>
                                        <Button Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_CaptureSnapshot]}" Command="{Binding CreateSnapshotCommand}" Padding="12,6" Background="{DynamicResource GuiBackgroundCardBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" Foreground="{DynamicResource GuiAccentBrush}" Cursor="Hand"/>
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Snapshots}" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource GuiBackgroundCardBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource GuiTextForegroundBrush}" />
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" FontSize="10" Foreground="#526475" Margin="0,2,8,0" />
                                                            <TextBlock Text="{Binding Type}" FontSize="10" Foreground="{DynamicResource GuiAccentBrush}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Width="110" Height="66" Margin="8,0" CornerRadius="4" BorderBrush="{DynamicResource GuiBorderBrush}" BorderThickness="1" MouseLeftButtonUp="SnapshotPreview_Click" Cursor="Hand" VerticalAlignment="Center">
                                                        <Image Source="{Binding ScreenshotPath, Converter={StaticResource FilePathToImage}}" Stretch="UniformToFill" />
                                                    </Border>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="↩" Width="26" Height="26" Background="{DynamicResource GuiBackgroundCardBrush}" BorderThickness="0" Foreground="{DynamicResource GuiAccentBrush}" FontSize="12" ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Snapshots_Restore]}" Command="{Binding DataContext.RestoreSnapshotCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Identifier}" />
                                                        <Button Content="✎" Width="26" Height="26" Margin="4,0" Background="{DynamicResource GuiBackgroundCardBrush}" BorderThickness="0" FontSize="12" ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Snapshots_Rename]}" Tag="{Binding Identifier}" Click="SnapshotRename_Click" />
                                                        <Button Content="✕" Width="26" Height="26" Background="#2C1A1A" BorderThickness="0" Foreground="#FCA5A5" FontSize="10" ToolTip="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Snapshots_Delete]}" Command="{Binding DataContext.DeleteSnapshotCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Identifier}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== THEMES PANEL ===== -->
                    <StackPanel x:Name="ThemesPanel" Visibility="Collapsed">
                        <Border Background="{DynamicResource GuiBackgroundCardBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Sidebar_Themes]}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource GuiAccentBrush}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Theme_OpenThemesFolder]}" Click="OpenThemesFolder_Click" Padding="12,6" Background="{DynamicResource GuiBackgroundCardBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" Foreground="{DynamicResource GuiAccentBrush}" Cursor="Hand"/>
                                </Grid>
                                
                                <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Theme_Description]}" Foreground="{DynamicResource GuiTextForegroundBrush}" FontSize="12" Margin="0,0,0,20" TextWrapping="Wrap" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="3*" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Left: Themes List -->
                                    <ListBox ItemsSource="{Binding ThemeNames}" SelectedItem="{Binding SelectedThemeName}" Background="Transparent" BorderThickness="0" Margin="0,0,16,0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource GuiBackgroundCardBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="0" Margin="0,4" MinWidth="200" Height="34">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource GuiTextForegroundBrush}" VerticalAlignment="Center" Margin="12,0" />
                                                        <Button Grid.Column="1" Tag="{Binding}" Click="DeleteTheme_Click" Content="✕" Width="24" Height="24" FontSize="10" Padding="0" Margin="0,0,6,0" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="#FCA5A5" Cursor="Hand" ToolTip="Delete theme" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    
                                    <!-- Right: Live Preview of Container styling -->
                                     <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top">
                                         <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Sync]}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource GuiAccentBrush}" Margin="0,0,0,12" />
                                         
                                         <!-- Mock Container styled by dynamic theme resources -->
                                         <Border CornerRadius="{DynamicResource ContainerCornerRadius}" 
                                                 BorderBrush="{DynamicResource ContainerBorderBrush}" 
                                                 BorderThickness="{DynamicResource ContainerBorderThickness}" 
                                                 Background="{DynamicResource ContainerBackgroundBrush}" 
                                                 Padding="0" Width="260" Height="170" HorizontalAlignment="Left" Margin="0,0,0,20">
                                             <Grid>
                                                 <Grid.RowDefinitions>
                                                     <RowDefinition Height="32" />
                                                     <RowDefinition Height="*" />
                                                 </Grid.RowDefinitions>
                                                 
                                                 <!-- Mock Header -->
                                                 <Border Background="{DynamicResource ContainerHeaderBrush}" CornerRadius="0">
                                                     <TextBlock Text="Minecraft Castle" Foreground="{DynamicResource ContainerTitleForeground}" FontWeight="Bold" FontSize="12" Margin="10,0" VerticalAlignment="Center" />
                                                 </Border>
                                                 
                                                 <!-- Mock Content -->
                                                 <StackPanel Grid.Row="1" Margin="12">
                                                     <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Theme_ShortcutsPreview]}" Foreground="{DynamicResource ContainerLabelsForeground}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8" />
                                                     <UniformGrid Columns="3">
                                                         <Border Background="#25FFFFFF" CornerRadius="4" Width="42" Height="42" Margin="2" BorderBrush="#15FFFFFF" BorderThickness="1">
                                                             <TextBlock Text="⛏️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                         </Border>
                                                         <Border Background="#25FFFFFF" CornerRadius="4" Width="42" Height="42" Margin="2" BorderBrush="#15FFFFFF" BorderThickness="1">
                                                             <TextBlock Text="⚔️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                         </Border>
                                                         <Border Background="#25FFFFFF" CornerRadius="4" Width="42" Height="42" Margin="2" BorderBrush="#15FFFFFF" BorderThickness="1">
                                                             <TextBlock Text="📦" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                         </Border>
                                                     </UniformGrid>
                                                 </StackPanel>
                                             </Grid>
                                         </Border>

                                         <!-- Theme Actions -->
                                         <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_StyleThemeCustomization]}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource GuiAccentBrush}" Margin="0,0,0,12" />

                                         <!-- Apply to All -->
                                         <Button Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Theme_ApplyToAll]}" Command="{Binding ApplyThemeToAllContainersCommand}" Padding="12,6" Background="{DynamicResource GuiBackgroundCardBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" Foreground="{DynamicResource GuiAccentBrush}" Cursor="Hand" HorizontalAlignment="Left" Width="260" Margin="0,0,0,16"/>
                                         
                                         <!-- Apply to Specific -->
                                         <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Theme_ApplyToSpecific]}" Foreground="{DynamicResource GuiTextForegroundBrush}" FontSize="11" Margin="0,0,0,6"/>
                                         <Grid Width="260" HorizontalAlignment="Left">
                                             <Grid.ColumnDefinitions>
                                                 <ColumnDefinition Width="*" />
                                                 <ColumnDefinition Width="Auto" />
                                             </Grid.ColumnDefinitions>
                                             <ComboBox ItemsSource="{Binding Containers}" SelectedItem="{Binding ApplyTargetContainer}" DisplayMemberPath="Name" Background="{DynamicResource GuiBackgroundMainBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" FontSize="12" Height="26" VerticalAlignment="Center" />
                                             <Button Grid.Column="1" Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_NewButton]}" Click="ApplySpecificTheme_Click" Padding="10,4" Background="{DynamicResource GuiBackgroundCardBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" Foreground="{DynamicResource GuiAccentBrush}" Cursor="Hand" Height="26" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                         </Grid>

                                         <!-- Create Theme from Container -->
                                         <TextBlock Text="Create theme from container" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource GuiAccentBrush}" Margin="0,20,0,12" />
                                         <TextBlock Text="Pick a container to save its colors as a reusable theme." Foreground="{DynamicResource GuiTextForegroundBrush}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                         <Grid Width="260" HorizontalAlignment="Left">
                                             <Grid.ColumnDefinitions>
                                                 <ColumnDefinition Width="*" />
                                                 <ColumnDefinition Width="Auto" />
                                             </Grid.ColumnDefinitions>
                                             <ComboBox x:Name="ThemeSourceContainerCombo" ItemsSource="{Binding Containers}" DisplayMemberPath="Name" Background="{DynamicResource GuiBackgroundMainBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" FontSize="12" Height="26" VerticalAlignment="Center" />
                                             <Button Grid.Column="1" Content="Create" Click="CreateThemeFromContainer_Click" Padding="10,4" Background="{DynamicResource GuiBackgroundCardBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" Foreground="{DynamicResource GuiAccentBrush}" Cursor="Hand" Height="26" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                         </Grid>
                                         <Button Content="Apply selected theme to container" Click="ApplySelectedThemeToContainer_Click" Padding="10,4" Background="{DynamicResource GuiBackgroundCardBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" Foreground="{DynamicResource GuiAccentBrush}" Cursor="Hand" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                                     </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== PLUGINS PANEL ===== -->
                    <StackPanel x:Name="PluginsPanel" Visibility="Collapsed">
                        <Border Background="{DynamicResource GuiBackgroundCardBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Sidebar_Plugins]}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource GuiAccentBrush}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Plugins_Refresh]}" Command="{Binding RefreshPluginsCommand}" Padding="12,6" Background="{DynamicResource GuiBackgroundCardBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" Foreground="{DynamicResource GuiAccentBrush}" Cursor="Hand" Margin="0,0,8,0"/>
                                    <Button Grid.Column="2" Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Plugins_OpenFolder]}" Click="OpenPluginsFolder_Click" Padding="12,6" Background="{DynamicResource GuiBackgroundCardBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" Foreground="{DynamicResource GuiAccentBrush}" Cursor="Hand"/>
                                </Grid>
                                
                                <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Plugins_Description]}" Foreground="{DynamicResource GuiTextForegroundBrush}" FontSize="12" Margin="0,0,0,20" TextWrapping="Wrap" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.2*" />
                                        <ColumnDefinition Width="2.8*" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Left: Plugins List -->
                                    <ListBox ItemsSource="{Binding Plugins}" SelectedItem="{Binding SelectedPlugin}" Background="Transparent" BorderThickness="0" Margin="0,0,16,0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource GuiBackgroundCardBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,4" MinWidth="220">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Plugin.Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource GuiTextForegroundBrush}" />
                                                            <TextBlock Text="{Binding Plugin.Version}" FontSize="10" Foreground="#526475" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <!-- Toggle Switch (Enable/Disable) -->
                                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=OneWay}" 
                                                                  Command="{Binding DataContext.TogglePluginCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                  CommandParameter="{Binding}"
                                                                  Style="{StaticResource ArcticToggleSwitchStyle}" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    
                                    <!-- Right: Selected Plugin Details -->
                                    <Border Grid.Column="1" Background="{DynamicResource GuiBackgroundCardBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="16,0,0,0" VerticalAlignment="Top">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            
                                            <!-- No selection placeholder -->
                                            <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Plugins_Placeholder]}" Foreground="#526475" FontSize="12" HorizontalAlignment="Center" Margin="0,20"
                                                       Visibility="{Binding SelectedPlugin, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />
                                            
                                            <StackPanel Visibility="{Binding SelectedPlugin, Converter={StaticResource NullToVisibility}}">
                                                <TextBlock Text="{Binding SelectedPlugin.Plugin.Name}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource GuiAccentBrush}" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding SelectedPlugin.Plugin.Description}" Foreground="{DynamicResource GuiTextForegroundBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,16"/>
                                                
                                                <Grid Margin="0,0,0,12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Plugins_Author]}" Foreground="#526475" FontSize="11" />
                                                    <TextBlock Grid.Column="1" Text="{Binding SelectedPlugin.Plugin.Author}" Foreground="{DynamicResource GuiTextForegroundBrush}" FontSize="11" />
                                                </Grid>
                                                
                                                <Grid Margin="0,0,0,16">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Plugins_Type]}" Foreground="#526475" FontSize="11" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Plugins_BuiltIn]}" Foreground="{DynamicResource GuiTextForegroundBrush}" FontSize="11" Visibility="{Binding SelectedPlugin.IsBuiltIn, Converter={StaticResource BoolToVisibility}}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Plugins_External]}" Foreground="{DynamicResource GuiTextForegroundBrush}" FontSize="11" Visibility="{Binding SelectedPlugin.IsBuiltIn, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                                </Grid>

                                                <!-- Widget Actions -->
                                                <Border BorderBrush="{DynamicResource GuiBorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0"
                                                        Visibility="{Binding SelectedPluginHasGadgets, Converter={StaticResource BoolToVisibility}}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Plugins_AvailableWidgets]}" Foreground="{DynamicResource GuiAccentBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10" />
                                                        <ItemsControl ItemsSource="{Binding SelectedPluginGadgets}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Content="{Binding Name, StringFormat='Add {0} to Desktop'}" 
                                                                            Command="{Binding DataContext.SpawnGadgetCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                            CommandParameter="{Binding}"
                                                                            Padding="12,6" Background="{DynamicResource GuiBackgroundCardBrush}" BorderBrush="{DynamicResource GuiBorderBrush}" Foreground="{DynamicResource GuiAccentBrush}" Cursor="Hand" Margin="0,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </StackPanel>

                </ScrollViewer>

            </Grid>
        </Grid>
    </Border>
</Window>