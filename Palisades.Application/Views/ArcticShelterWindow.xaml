                                <CheckBox Margin="0,6,0,0" IsChecked="{Binding SelectedContainer.RoundedCornersEnabled}" FontSize="12" Content="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_RoundedCorners]}" Style="{StaticResource ArcticToggleSwitchStyle}"/>

