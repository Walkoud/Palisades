                                    <Slider Grid.Column="1" Style="{StaticResource ArcticSliderStyle}" Minimum="9" Maximum="20" Value="{Binding SelectedContainer.TitleFontSize, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="2" Text="{Binding SelectedContainer.TitleFontSize, StringFormat={}{0:F0}}" Foreground="{DynamicResource GuiTextForegroundBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" />
