                    <TextBlock Text="{Binding Source={x:Static svc:TranslationService.Instance}, Path=[Db_Header_Suite]}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource GuiTextForegroundBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="—" Width="46" Height="34" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource GuiTextForegroundBrush}" FontSize="14" Click="Minimize_Click" Cursor="Hand" Style="{StaticResource {x:Type Button}}"/>
                    <Button Content="✕" Width="46" Height="34" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource GuiTextForegroundBrush}" FontSize="13" Click="Close_Click" Cursor="Hand" Style="{StaticResource {x:Type Button}}"/>
                </StackPanel>
