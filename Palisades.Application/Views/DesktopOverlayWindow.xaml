<Window x:Class="Palisades.Views.DesktopOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Palisades.Converters"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="False"
        WindowState="Normal">
    <Window.Resources>
        <conv:PathToImageConverter x:Key="IconConverter" ShowArrow="True" />
    </Window.Resources>
    <Grid>
        <Canvas x:Name="OverlayCanvas" />
    </Grid>
</Window>
